{% schema %}
{
  "name": "Featured products custom",
  "class": "shopify-section--featured-products",

  "settings": [

    {
      "type": "text",
      "id": "section_custom_class",
      "label": "Custom class",
      "info": "Add a custom CSS class to the whole section."
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured products"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },


    {
      "type": "header",
      "content": "Product sequence"
    },

    {
      "type": "paragraph",
      "content": "Select a product for each position. Products will display in exactly this order."
    },

    {
      "type": "product",
      "id": "product_1",
      "label": "Position 1"
    },

    {
      "type": "product",
      "id": "product_2",
      "label": "Position 2"
    },

    {
      "type": "product",
      "id": "product_3",
      "label": "Position 3"
    },

    {
      "type": "product",
      "id": "product_4",
      "label": "Position 4"
    },

    {
      "type": "product",
      "id": "product_5",
      "label": "Position 5"
    },

    {
      "type": "product",
      "id": "product_6",
      "label": "Position 6"
    },

    {
      "type": "product",
      "id": "product_7",
      "label": "Position 7"
    },

    {
      "type": "product",
      "id": "product_8",
      "label": "Position 8"
    },

    {
      "type": "product",
      "id": "product_9",
      "label": "Position 9"
    },

    {
      "type": "product",
      "id": "product_10",
      "label": "Position 10"
    },


    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "products_per_row_mobile",
      "label": "Products per row on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },

    {
      "type": "range",
      "id": "products_per_row_desktop",
      "label": "Products per row on desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4
    },

    {
      "type": "range",
      "id": "horizontal_spacing_factor",
      "label": "Horizontal spacing factor",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1
    },

    {
      "type": "range",
      "id": "vertical_spacing_factor",
      "label": "Vertical spacing factor",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1
    },


    {
      "type": "header",
      "content": "CTA button"
    },

    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA button",
      "default": true
    },

    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "SE ALLE 10 PRODUKTER"
    },

    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }

  ],

  "presets": [
    {
      "name": "Featured products custom"
    }
  ]
}
{% endschema %}