  or section.settings.product_4 != blank
  or section.settings.product_5 != blank
  or section.settings.product_6 != blank
  or section.settings.product_7 != blank
  or section.settings.product_8 != blank
  or section.settings.product_9 != blank
  or section.settings.product_10 != blank
-%}

  {%- comment -%}
    Save the current product before displaying selected products.
    This allows us to exclude the product currently being viewed.
  {%- endcomment -%}

  {%- assign current_product = product -%}


  <div
    class="
      {% if section.settings.section_custom_class != blank %}
        {{ section.settings.section_custom_class }}
      {% endif %}
      section-spacing
      color-scheme
      color-scheme--{{ section.settings.color_scheme.id }}
    "
  >

    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}

      <div class="container">

        <div class="section-header">

          {%- if section.settings.subheading != blank -%}
            <p class="section-header__subheading">
              {{ section.settings.subheading }}
            </p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="h2">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}

        </div>

      </div>

    {%- endif -%}


