<style>
  #shopify-section-{{ section.id }} {
    --product-list-items-per-row: {{ section.settings.products_per_row_mobile }};
    --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
    --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --product-list-items-per-row: {{ section.settings.products_per_row_desktop }};
    }
  }

  /* =========================================
     HEADER
  ========================================= */

  .related-products-header-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
  }

  .related-products-header-{{ section.id }} .section-header {
    margin-bottom: 0;
  }

  /* =========================================
     PREVIOUS / NEXT BUTTONS
  ========================================= */

  .related-products-navigation-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .related-products-navigation-{{ section.id }} button {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid #777;
    background: transparent;
    color: #222;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .related-products-navigation-{{ section.id }} button:first-child {
    background: #292522;
    color: #fff;
    border-color: #292522;
  }

  .related-products-navigation-{{ section.id }} button:hover {
    background: #292522;
    color: #fff;
    border-color: #292522;
  }

  .related-products-navigation-{{ section.id }} button:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .related-products-navigation-{{ section.id }} button:disabled:hover {
    background: transparent;
    color: #222;
    border-color: #777;
  }

  .related-products-navigation-{{ section.id }}
  button:first-child:disabled:hover {
    background: #292522;
    color: #fff;
    border-color: #292522;
  }

  .related-products-navigation-{{ section.id }} svg {
    width: 13px;
    height: 13px;
  }

  /* =========================================
     PRODUCT SLIDER
  ========================================= */

  .related-products-slider-{{ section.id }} {
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin: 0;
    padding: 0;
    gap: 20px;
  }

  .related-products-slider-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  .related-products-slider-{{ section.id }} .product-list__item {
    flex: 0 0 calc(
      (100% - ((var(--product-list-items-per-row) - 1) * 20px))
      / var(--product-list-items-per-row)
    ) !important;

    min-width: 0;
    scroll-snap-align: start;
  }

  /* =========================================
     PRODUCT CARD
  ========================================= */

  .related-products-card-{{ section.id }}
  .homepage-product-card__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
  }

  .related-products-card-{{ section.id }}
  .homepage-product-card__stars {
    display: flex;
    align-items: center;
    gap: 2px;
    line-height: 1;
  }

  .related-products-card-{{ section.id }}
  .homepage-product-card__star {
    position: relative;
    display: inline-block;
    width: 15px;
    height: 15px;
    font-size: 15px;
    line-height: 15px;
  }

  .related-products-card-{{ section.id }}
  .homepage-product-card__star--full {
    color: #000;
  }

  .related-products-card-{{ section.id }}
  .homepage-product-card__star--empty {
    color: #000;
    opacity: 0.2;
  }

  .related-products-card-{{ section.id }}
  .homepage-product-card__star--half {
    color: #000;
  }

  .related-products-card-{{ section.id }}
  .homepage-product-card__star--half::after {
    content: "★";
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
    color: #000;
  }

  .related-products-card-{{ section.id }}
  .homepage-product-card__rating-value {
    font-size: 12px;
    line-height: 1;
  }

  .related-products-card-{{ section.id }}
  .homepage-product-card__category {
    margin-bottom: 5px;
  }

  .related-products-card-{{ section.id }}
  .homepage-product-card__highlights {
    margin-top: 5px;
  }

  /* =========================================
     MOBILE
  ========================================= */

  @media screen and (max-width: 699px) {

    .related-products-header-{{ section.id }} {
      align-items: center;
      margin-bottom: 20px;
    }

    .related-products-navigation-{{ section.id }} {
      gap: 6px;
    }

    .related-products-navigation-{{ section.id }} button {
      width: 30px;
      height: 30px;
    }

    .related-products-slider-{{ section.id }} {
      gap: 10px;
    }

    .related-products-slider-{{ section.id }}
    .product-list__item {
      flex: 0 0 calc(
        (100% - ((var(--product-list-items-per-row) - 1) * 10px))
        / var(--product-list-items-per-row)
      ) !important;
    }
  }
</style>


{%- if product != blank -%}

  {%- assign current_product = product -%}

  {%- comment -%}
    Find the first collection assigned to the current product.
    "All Collections" is ignored.
  {%- endcomment -%}

  {%- assign related_collection = blank -%}

  {%- for product_collection in current_product.collections -%}

    {%- assign collection_name = product_collection.title
      | strip
      | downcase
    -%}

    {%- unless collection_name == 'all collections' -%}

      {%- assign related_collection = product_collection -%}

      {%- break -%}

    {%- endunless -%}

  {%- endfor -%}


  {%- comment -%}
    Count products in the same collection,
    excluding the current product.
  {%- endcomment -%}

  {%- assign related_product_count = 0 -%}

  {%- if related_collection != blank -%}

    {%- for collection_product in related_collection.products -%}

      {%- if collection_product.id != current_product.id -%}

        {%- assign related_product_count =
          related_product_count | plus: 1
        -%}

      {%- endif -%}

    {%- endfor -%}

  {%- endif -%}


  {%- comment -%}
    IMPORTANT:

    The complete section only appears when:
    1. A collection exists
    2. At least one other product exists
  {%- endcomment -%}

  {%- if related_collection != blank
    and related_product_count > 0
  -%}


    <div
      class="
        {% if section.settings.section_custom_class != blank %}
          {{ section.settings.section_custom_class }}
        {% endif %}
        section-spacing
        color-scheme
        color-scheme--{{ section.settings.color_scheme.id }}
      "
    >

      <div class="container">


        <!-- =====================================
             HEADER
        ====================================== -->

        <div class="related-products-header-{{ section.id }}">

          <div class="section-header">

            {%- if section.settings.subheading != blank -%}

              <p class="section-header__subheading">
                {{ section.settings.subheading }}
              </p>

            {%- endif -%}


            {%- if section.settings.heading != blank -%}

              <h2 class="h2">
                {{ section.settings.heading }}
              </h2>

            {%- endif -%}

          </div>


          <!-- =====================================
               PREVIOUS / NEXT
          ====================================== -->

          <div
            class="
              related-products-navigation-{{ section.id }}
            "
          >

            <button
              type="button"
              class="related-products-prev-{{ section.id }}"
              aria-label="Previous products"
            >

              <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >

                <path
                  d="M15 18L9 12L15 6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

              </svg>

            </button>


            <button
              type="button"
              class="related-products-next-{{ section.id }}"
              aria-label="Next products"
            >

              <svg
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >

                <path
                  d="M9 18L15 12L9 6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />

              </svg>

            </button>

          </div>

        </div>


        <!-- =====================================
             PRODUCTS
        ====================================== -->

        <div
          class="
            product-list
            product-list--center
            related-products-slider-{{ section.id }}
          "
          data-related-slider
        >

          {%- assign products_shown = 0 -%}


          {%- for selected_product in related_collection.products -%}


            {%- if selected_product.id != current_product.id -%}


              {%- if products_shown < section.settings.max_products -%}


                {%- assign product_category =
                  related_collection.title
                -%}


                {%- assign product_highlights =
                  selected_product.metafields.custom.product_highlights.value
                -%}


                {%- assign rating_count =
                  selected_product.metafields.custom.product_rating.value.rating
                  | plus: 0
                -%}


                <div class="product-list__item">

                  <div
                    class="
                      product-card
                      related-products-card-{{ section.id }}
                    "
                  >


                    <!-- =====================================
                         PRODUCT IMAGE
                    ====================================== -->

                    {%- if selected_product.featured_media != blank -%}

                      <a
                        href="{{ selected_product.url }}"
                        class="product-card__figure"
                      >

                        <div class="product-card__media">

                          {{
                            selected_product.featured_media
                            | image_url: width: 1200
                            | image_tag:
                              loading: 'lazy',
                              widths: '200,300,400,500,600,800,1000,1200',
                              sizes: '(max-width: 699px) 50vw, 25vw',
                              class: 'product-card__image'
                          }}

                        </div>

                      </a>

                    {%- endif -%}


                    <div class="product-card__info">


                      <!-- =====================================
                           CATEGORY
                      ====================================== -->

                      {%- if product_category != blank -%}

                        <div
                          class="
                            homepage-product-card__category
                          "
                        >

                          {{ product_category }}

                        </div>

                      {%- endif -%}


                      <!-- =====================================
                           TITLE
                      ====================================== -->

                      <a
                        href="{{ selected_product.url }}"
                        class="product-card__title"
                      >

                        {{ selected_product.title }}

                      </a>


                      <!-- =====================================
                           HIGHLIGHTS
                      ====================================== -->

                      {%- if product_highlights != blank -%}

                        <div
                          class="
                            homepage-product-card__highlights
                          "
                        >

                          {{ product_highlights }}

                        </div>

                      {%- endif -%}


                      <!-- =====================================
                           RATING
                      ====================================== -->

                      {%- if rating_count > 0 -%}

                        <div
                          class="
                            homepage-product-card__rating
                          "
                        >

                          <div
                            class="
                              homepage-product-card__stars
                            "
                            aria-label="
                              {{ rating_count }} out of 5 stars
                            "
                          >

                            {%- for star in (1..5) -%}

                              {%- assign previous_star =
                                star | minus: 1
                              -%}


                              {%- if rating_count >= star -%}

                                <span
                                  class="
                                    homepage-product-card__star
                                    homepage-product-card__star--full
                                  "
                                >
                                  ★
                                </span>


                              {%- elsif rating_count > previous_star -%}

                                <span
                                  class="
                                    homepage-product-card__star
                                    homepage-product-card__star--half
                                  "
                                >
                                  ★
                                </span>


                              {%- else -%}

                                <span
                                  class="
                                    homepage-product-card__star
                                    homepage-product-card__star--empty
                                  "
                                >
                                  ★
                                </span>

                              {%- endif -%}

                            {%- endfor -%}

                          </div>


                          <span
                            class="
                              homepage-product-card__rating-value
                            "
                          >

                            {{ rating_count }}

                          </span>

                        </div>

                      {%- endif -%}


                      <!-- =====================================
                           PRICE
                      ====================================== -->

                      <div class="product-card__price">

                        {%- render 'price-list',
                          product: selected_product
                        -%}

                      </div>


                    </div>

                  </div>

                </div>


                {%- assign products_shown =
                  products_shown | plus: 1
                -%}


              {%- endif -%}


            {%- endif -%}


          {%- endfor -%}

        </div>

      </div>

    </div>


  {%- endif -%}

{%- endif -%}


<!-- =========================================
     SLIDER JAVASCRIPT
========================================= -->

<script>
  document.addEventListener('DOMContentLoaded', function () {

    const section = document.querySelector(
      '#shopify-section-{{ section.id }}'
    );

    if (!section) {
      return;
    }


    const slider = section.querySelector(
      '[data-related-slider]'
    );

    const prevButton = section.querySelector(
      '.related-products-prev-{{ section.id }}'
    );

    const nextButton = section.querySelector(
      '.related-products-next-{{ section.id }}'
    );


    if (!slider || !prevButton || !nextButton) {
      return;
    }


    /*
     * Calculate one product card width
     * including the gap.
     */
    function getScrollAmount() {

      const firstItem = slider.querySelector(
        '.product-list__item'
      );

      if (!firstItem) {
        return 0;
      }


      const itemWidth =
        firstItem.getBoundingClientRect().width;


      const sliderStyle =
        window.getComputedStyle(slider);


      const gap =
        parseFloat(sliderStyle.columnGap) ||
        parseFloat(sliderStyle.gap) ||
        0;


      return itemWidth + gap;
    }


    /*
     * Update navigation buttons.
     */
    function updateButtons() {

      const maxScroll =
        slider.scrollWidth -
        slider.clientWidth;


      /*
       * If all products fit on screen,
       * hide arrows.
       */
      if (maxScroll <= 5) {

        prevButton.style.display = 'none';
        nextButton.style.display = 'none';

        return;
      }


      prevButton.style.display = 'flex';
      nextButton.style.display = 'flex';


      /*
       * Previous button.
       */
      if (slider.scrollLeft <= 5) {

        prevButton.disabled = true;

      } else {

        prevButton.disabled = false;

      }


      /*
       * Next button.
       */
      if (
        slider.scrollLeft >=
        maxScroll - 5
      ) {

        nextButton.disabled = true;

      } else {

        nextButton.disabled = false;

      }

    }


    /*
     * Previous button click.
     */
    prevButton.addEventListener(
      'click',
      function () {

        slider.scrollBy({
          left: -getScrollAmount(),
          behavior: 'smooth'
        });

      }
    );


    /*
     * Next button click.
     */
    nextButton.addEventListener(
      'click',
      function () {

        slider.scrollBy({
          left: getScrollAmount(),
          behavior: 'smooth'
        });

      }
    );


    /*
     * Update buttons while scrolling.
     */
    slider.addEventListener(
      'scroll',
      updateButtons,
      {
        passive: true
      }
    );


    /*
     * Update after browser resize.
     */
    window.addEventListener(
      'resize',
      updateButtons
    );


    /*
     * Initial state.
     */
    updateButtons();

  });
</script>


{% schema %}
{
  "name": "Related products custom",
  "class": "shopify-section--related-products",

  "settings": [

    {
      "type": "text",
      "id": "section_custom_class",
      "label": "Custom class",
      "info": "Add a custom CSS class to the whole section."
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Relaterede Produkter"
    },

    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },

    {
      "type": "header",
      "content": "Product layout"
    },

    {
      "type": "range",
      "id": "max_products",
      "label": "Maximum products",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 10
    },

    {
      "type": "range",
      "id": "products_per_row_mobile",
      "label": "Products per row on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },

    {
      "type": "range",
      "id": "products_per_row_desktop",
      "label": "Products per row on desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },

    {
      "type": "range",
      "id": "horizontal_spacing_factor",
      "label": "Horizontal spacing factor",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1
    },

    {
      "type": "range",
      "id": "vertical_spacing_factor",
      "label": "Vertical spacing factor",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1
    }

  ],

  "presets": [
    {
      "name": "Related products custom"
    }
  ]
}
{% endschema %}