{% comment %}
  Custom Reviews Section
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} {
    --cr-bg: {{ section.settings.background_color }};
    --cr-card-bg: {{ section.settings.card_background }};
    --cr-border: {{ section.settings.card_border_color }};
    --cr-heading: {{ section.settings.heading_color }};
    --cr-text: {{ section.settings.text_color }};
    --cr-muted: {{ section.settings.muted_color }};
    --cr-star: {{ section.settings.star_color }};
    --cr-eyebrow: {{ section.settings.eyebrow_color }};
  }

  #shopify-section-{{ section.id }} .custom-reviews {
    background: var(--cr-bg);
    width: 100%;
  }

  #shopify-section-{{ section.id }} .custom-reviews__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.horizontal_padding }}px;
    padding-right: {{ section.settings.horizontal_padding }}px;
  }

  /* HEADER */

  #shopify-section-{{ section.id }} .custom-reviews__header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: {{ section.settings.header_bottom_spacing }}px;
  }

  #shopify-section-{{ section.id }} .custom-reviews__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_spacing }}px;
    color: var(--cr-eyebrow);
    font-size: {{ section.settings.eyebrow_size }}px;
    line-height: 1.4;
    font-weight: {{ section.settings.eyebrow_weight }};
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    text-transform: {{ section.settings.eyebrow_case }};
  }

  #shopify-section-{{ section.id }} .custom-reviews__heading {
    margin: 0 0 {{ section.settings.heading_spacing }}px;
    color: var(--cr-heading);
    font-size: {{ section.settings.heading_size }}px;
    line-height: {{ section.settings.heading_line_height }};
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    text-transform: {{ section.settings.heading_case }};
  }

  /* OVERALL RATING */

  #shopify-section-{{ section.id }} .custom-reviews__summary {
    display: flex;
    align-items: center;
    justify-content: {{ section.settings.header_alignment }};
    gap: 9px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .custom-reviews__stars {
    display: inline-flex;
    align-items: center;
    gap: {{ section.settings.star_gap }}px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .custom-reviews__star {
    color: var(--cr-star);
    font-size: {{ section.settings.star_size }}px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .custom-reviews__summary-text {
    color: var(--cr-muted);
    font-size: {{ section.settings.summary_text_size }}px;
    line-height: 1.4;
    font-weight: {{ section.settings.summary_text_weight }};
  }

  /* REVIEW GRID */

  #shopify-section-{{ section.id }} .custom-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
  }

  /* REVIEW CARD */

  #shopify-section-{{ section.id }} .custom-reviews__card {
    background: var(--cr-card-bg);
    border: {{ section.settings.card_border_width }}px solid var(--cr-border);
    padding: {{ section.settings.card_padding }}px;
    min-height: {{ section.settings.card_min_height }}px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .custom-reviews__card-stars {
    display: flex;
    align-items: center;
    gap: {{ section.settings.card_star_gap }}px;
    margin-bottom: {{ section.settings.card_star_spacing }}px;
  }

  #shopify-section-{{ section.id }} .custom-reviews__card-star {
    color: var(--cr-star);
    font-size: {{ section.settings.card_star_size }}px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .custom-reviews__text {
    margin: 0;
    color: var(--cr-text);
    font-size: {{ section.settings.review_text_size }}px;
    line-height: {{ section.settings.review_line_height }};
    font-weight: {{ section.settings.review_text_weight }};
  }

  #shopify-section-{{ section.id }} .custom-reviews__customer {
    margin-top: auto;
    padding-top: {{ section.settings.customer_spacing }}px;
  }

  #shopify-section-{{ section.id }} .custom-reviews__name {
    margin: 0 0 {{ section.settings.name_spacing }}px;
    color: var(--cr-heading);
    font-size: {{ section.settings.name_size }}px;
    line-height: 1.3;
    font-weight: {{ section.settings.name_weight }};
    text-transform: {{ section.settings.name_case }};
  }

  #shopify-section-{{ section.id }} .custom-reviews__meta {
    display: flex;
    align-items: center;
    gap: 5px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .custom-reviews__product {
    color: var(--cr-muted);
    font-size: {{ section.settings.product_size }}px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .custom-reviews__verified {
    color: var(--cr-muted);
    font-size: {{ section.settings.verified_size }}px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .custom-reviews__separator {
    color: var(--cr-muted);
    font-size: {{ section.settings.product_size }}px;
  }

  /* TABLET */

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .custom-reviews__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #shopify-section-{{ section.id }} .custom-reviews__card:last-child {
      grid-column: 1 / -1;
    }
  }

  /* MOBILE */

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .custom-reviews__inner {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: {{ section.settings.mobile_horizontal_padding }}px;
      padding-right: {{ section.settings.mobile_horizontal_padding }}px;
    }

    #shopify-section-{{ section.id }} .custom-reviews__header {
      margin-bottom: {{ section.settings.mobile_header_bottom_spacing }}px;
    }

    #shopify-section-{{ section.id }} .custom-reviews__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    #shopify-section-{{ section.id }} .custom-reviews__summary {
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .custom-reviews__grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_card_gap }}px;
    }

    #shopify-section-{{ section.id }} .custom-reviews__card:last-child {
      grid-column: auto;
    }

    #shopify-section-{{ section.id }} .custom-reviews__card {
      min-height: auto;
      padding: {{ section.settings.mobile_card_padding }}px;
    }

    #shopify-section-{{ section.id }} .custom-reviews__text {
      font-size: {{ section.settings.mobile_review_text_size }}px;
    }
  }

  {% if section.settings.custom_css != blank %}
    {{ section.settings.custom_css }}
  {% endif %}
</style>

<section
  class="custom-reviews {{ section.settings.custom_class }}"
  id="custom-reviews-{{ section.id }}"
>
  <div class="custom-reviews__inner">

    {% if section.settings.show_eyebrow
      or section.settings.show_heading
      or section.settings.show_summary
    %}

      <div class="custom-reviews__header">

        {% if section.settings.show_eyebrow %}
          <p class="custom-reviews__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.show_heading %}
          <h2 class="custom-reviews__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.show_summary %}
          <div class="custom-reviews__summary">

            <div class="custom-reviews__stars">

              {% assign overall_rating = section.settings.overall_rating | round %}

              {% for i in (1..5) %}
                {% if i <= overall_rating %}
                  <span class="custom-reviews__star">★</span>
                {% else %}
                  <span class="custom-reviews__star">☆</span>
                {% endif %}
              {% endfor %}

            </div>

            <span class="custom-reviews__summary-text">
              {{ section.settings.overall_rating_text }}

              {% if section.settings.review_count != blank %}
                · {{ section.settings.review_count }}
                {{ section.settings.review_count_label }}
              {% endif %}
            </span>

          </div>
        {% endif %}

      </div>

    {% endif %}

    <div class="custom-reviews__grid">

      {% for block in section.blocks %}

        {% if block.type == 'review' %}

          <article
            class="custom-reviews__card"
            {{ block.shopify_attributes }}
          >

            {% if block.settings.show_stars %}

              <div class="custom-reviews__card-stars">

                {% assign review_rating = block.settings.rating | round %}

                {% for i in (1..5) %}

                  {% if i <= review_rating %}
                    <span class="custom-reviews__card-star">★</span>
                  {% else %}
                    <span class="custom-reviews__card-star">☆</span>
                  {% endif %}

                {% endfor %}

              </div>

            {% endif %}

            {% if block.settings.review_text != blank %}
              <p class="custom-reviews__text">
                {{ block.settings.review_text }}
              </p>
            {% endif %}

            <div class="custom-reviews__customer">

              {% if block.settings.customer_name != blank %}
                <p class="custom-reviews__name">
                  {{ block.settings.customer_name }}
                </p>
              {% endif %}

              <div class="custom-reviews__meta">

                {% if block.settings.product_name != blank %}

                  <span class="custom-reviews__product">
                    {{ block.settings.product_name }}
                  </span>

                {% endif %}

                {% if block.settings.show_separator
                  and block.settings.product_name != blank
                  and block.settings.verified_text != blank
                %}

                  <span class="custom-reviews__separator">
                    ·
                  </span>

                {% endif %}

                {% if block.settings.verified_text != blank %}

                  <span class="custom-reviews__verified">
                    {{ block.settings.verified_text }}
                  </span>

                {% endif %}

              </div>

            </div>

          </article>

        {% endif %}

      {% endfor %}

    </div>

  </div>
</section>

