{% liquid
  assign current_collection = collection

  if current_collection == blank
    assign current_collection = collections.all
  endif

  assign products_per_page = section.settings.products_per_page

  assign current_sort = current_collection.sort_by

  if current_sort == blank
    assign current_sort = 'manual'
  endif
%}


<section
  id="CustomProductGrid-{{ section.id }}"
  class="custom-product-grid {{ section.settings.custom_class }}"
  data-section-id="{{ section.id }}"
  style="
    --cpg-bg: {{ section.settings.background_color }};
    --cpg-text: {{ section.settings.text_color }};
    --cpg-muted: {{ section.settings.muted_color }};
    --cpg-border: {{ section.settings.border_color }};
    --cpg-accent: {{ section.settings.accent_color }};
    --cpg-card-bg: {{ section.settings.card_background }};
    --cpg-grid-gap: {{ section.settings.grid_gap }}px;
    --cpg-top-padding: {{ section.settings.padding_top }}px;
    --cpg-bottom-padding: {{ section.settings.padding_bottom }}px;
    --cpg-max-width: {{ section.settings.max_width }}px;
  "
>

  <div class="custom-product-grid__container">


    <!-- ========================================= -->
    <!-- TOP BAR -->
    <!-- ========================================= -->

    <div class="custom-product-grid__top">


      <!-- PRODUCT COUNT -->

      {% if section.settings.show_product_count %}

        <div class="custom-product-grid__count">

          {% if current_sort == 'manual' and section.settings.manual_products != blank %}

            {% assign manual_count = 0 %}

            {% if current_collection.handle == 'all' %}

              {% for manual_product in section.settings.manual_products %}

                {% if manual_product.available %}

                  {% assign manual_count = manual_count | plus: 1 %}

                {% endif %}

              {% endfor %}

            {% else %}

              {% for manual_product in section.settings.manual_products %}

                {% if manual_product.available %}

                  {% for product_collection in manual_product.collections %}

                    {% if product_collection.handle == current_collection.handle %}

                      {% assign manual_count = manual_count | plus: 1 %}

                      {% break %}

                    {% endif %}

                  {% endfor %}

                {% endif %}

              {% endfor %}

            {% endif %}


            {% if manual_count > 0 %}

              Visar 1–{{ manual_count }} av {{ manual_count }} produkter

            {% else %}

              Inga produkter

            {% endif %}


          {% else %}

            {% paginate current_collection.products by products_per_page %}

              {% if paginate.items > 0 %}

                {% assign count_start = paginate.current_offset | plus: 1 %}

                {% assign count_end = paginate.current_offset | plus: current_collection.products.size %}

                {% if count_end > paginate.items %}

                  {% assign count_end = paginate.items %}

                {% endif %}

                Visar {{ count_start }}–{{ count_end }} av {{ paginate.items }} produkter

              {% else %}

                Inga produkter

              {% endif %}

            {% endpaginate %}

          {% endif %}

        </div>

      {% endif %}



      <!-- ========================================= -->
      <!-- FILTER CONTROLS -->
      <!-- ========================================= -->

      <div class="custom-product-grid__controls">


        <!-- ========================================= -->
        <!-- CATEGORY -->
        <!-- ========================================= -->

        {% if section.settings.enable_category_dropdown %}

          <details class="custom-product-grid__dropdown custom-product-grid__category">

            <summary class="custom-product-grid__select">

              <span>
                {{ section.settings.category_label }}
              </span>

              <svg
                width="10"
                height="6"
                viewBox="0 0 10 6"
                fill="none"
              >

                <path
                  d="M1 1L5 5L9 1"
                  stroke="currentColor"
                  stroke-width="1"
                />

              </svg>

            </summary>


            <div class="custom-product-grid__dropdown-menu">


              <!-- ALL PRODUCTS -->

              {% if section.settings.show_all_products_option %}

                {% assign all_products_url = routes.all_products_collection_url %}


                {% if current_sort != blank and current_sort != 'manual' %}

                  {% assign all_products_url = all_products_url
                    | append: '?sort_by='
                    | append: current_sort
                  %}

                {% endif %}


                <a
                  href="{{ all_products_url }}"
                  class="
                    custom-product-grid__collection-option
                    {% if current_collection.handle == 'all' %}
                      is-active
                    {% endif %}
                  "
                  data-ajax-filter
                >

                  <span>
                    {{ section.settings.all_products_label }}
                  </span>


                  {% if current_collection.handle == 'all' %}

                    <span class="custom-product-grid__check">
                      ✓
                    </span>

                  {% endif %}

                </a>

              {% endif %}



              <!-- SHOPIFY COLLECTIONS -->

              {% for shop_collection in collections %}

                {% unless shop_collection.handle == 'all-collections' %}

                  {% if shop_collection.products_count > 0 %}

                    {% assign category_url = shop_collection.url %}


                    <!-- KEEP CURRENT SORT -->

                    {% if current_sort != blank and current_sort != 'manual' %}

                      {% assign category_url = category_url
                        | append: '?sort_by='
                        | append: current_sort
                      %}

                    {% endif %}


                    <a
                      href="{{ category_url }}"
                      class="
                        custom-product-grid__collection-option
                        {% if current_collection.handle == shop_collection.handle %}
                          is-active
                        {% endif %}
                      "
                      data-ajax-filter
                    >

                      <span>
                        {{ shop_collection.title }}
                      </span>


                      {% if section.settings.show_collection_product_count %}

                        <span class="custom-product-grid__collection-count">
                          {{ shop_collection.products_count }}
                        </span>

                      {% endif %}


                      {% if current_collection.handle == shop_collection.handle %}

                        <span class="custom-product-grid__check">
                          ✓
                        </span>

                      {% endif %}

                    </a>

                  {% endif %}

                {% endunless %}

              {% endfor %}

            </div>

          </details>

        {% endif %}



        <!-- ========================================= -->
        <!-- SORT -->
        <!-- ========================================= -->

        {% if section.settings.enable_sorting %}

          <details class="custom-product-grid__dropdown custom-product-grid__sort">

            <summary class="custom-product-grid__select">

              <span>

                {% assign active_sort_name = 'Populär' %}


                {% if current_sort == 'manual' %}

                  {% assign active_sort_name = 'Populär' %}

                {% else %}

                  {% for option in current_collection.sort_options %}

                    {% if option.value == current_sort %}

                      {% assign active_sort_name = option.name %}

                    {% endif %}

                  {% endfor %}

                {% endif %}


                Sortér: {{ active_sort_name }}

              </span>


              <svg
                width="10"
                height="6"
                viewBox="0 0 10 6"
                fill="none"
              >

                <path
                  d="M1 1L5 5L9 1"
                  stroke="currentColor"
                  stroke-width="1"
                />

              </svg>

            </summary>


            <div class="custom-product-grid__dropdown-menu custom-product-grid__sort-menu">


              {% for option in current_collection.sort_options %}


                {% assign sort_url = current_collection.url %}


                {% if option.value != 'manual' %}

                  {% assign sort_url = sort_url
                    | append: '?sort_by='
                    | append: option.value
                  %}

                {% endif %}


                <a
                  href="{{ sort_url }}"
                  class="
                    custom-product-grid__sort-option
                    {% if option.value == current_sort %}
                      is-active
                    {% endif %}
                  "
                  data-ajax-filter
                >

                  <span>

                    {% if option.value == 'manual' %}

                      Populär

                    {% else %}

                      {{ option.name }}

                    {% endif %}

                  </span>


                  {% if option.value == current_sort %}

                    <span class="custom-product-grid__check">
                      ✓
                    </span>

                  {% endif %}

                </a>

              {% endfor %}

            </div>

          </details>

        {% endif %}

      </div>

    </div>



    <!-- ========================================= -->
    <!-- PRODUCTS -->
    <!-- ========================================= -->


    {% if current_sort == 'manual' and section.settings.manual_products != blank %}


      <!-- ========================================= -->
      <!-- MANUAL PRODUCT ORDER -->
      <!-- ========================================= -->

      {% assign manual_products_found = 0 %}


      <div
        class="
          custom-product-grid__products
          custom-product-grid__products--{{ section.settings.desktop_columns }}
        "
      >


        {% for product in section.settings.manual_products %}

          {% assign show_manual_product = false %}


          {% if product.available %}


            <!-- ALL PRODUCTS -->

            {% if current_collection.handle == 'all' %}

              {% assign show_manual_product = true %}


            <!-- SPECIFIC COLLECTION -->

            {% else %}

              {% for product_collection in product.collections %}

                {% if product_collection.handle == current_collection.handle %}

                  {% assign show_manual_product = true %}

                  {% break %}

                {% endif %}

              {% endfor %}

            {% endif %}

          {% endif %}



          {% if show_manual_product %}

            {% assign manual_products_found = manual_products_found | plus: 1 %}


            <!-- ================================= -->
            <!-- PRODUCT CARD -->
            <!-- ================================= -->

            <article class="custom-product-card">


              <!-- IMAGE -->

              <a
                href="{{ product.url }}"
                class="custom-product-card__image"
              >

                {% if product.featured_image %}

                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300,400,500,600,700,800',
                      sizes: '(min-width: 990px) 25vw, 50vw',
                      class: 'custom-product-card__img',
                      alt: product.featured_image.alt | default: product.title
                  }}

                {% else %}

                  {{ 'product-1'
                    | placeholder_svg_tag:
                    'custom-product-card__placeholder'
                  }}

                {% endif %}


                <!-- BADGES -->

                {% if section.settings.show_badges %}

                  <div class="custom-product-card__badges">

                    {% if product.tags contains 'Bestseller'
                      or product.tags contains 'BESTSELLER' %}

                      <span class="custom-product-card__badge">
                        Bestseller
                      </span>

                    {% elsif product.tags contains 'New'
                      or product.tags contains 'NEW' %}

                      <span class="custom-product-card__badge">
                        Ny
                      </span>

                    {% elsif product.compare_at_price > product.price %}

                      <span class="custom-product-card__badge">
                        Sale
                      </span>

                    {% endif %}

                  </div>

                {% endif %}

              </a>



              <!-- CONTENT -->

              <div class="custom-product-card__content">


                <!-- COLLECTION -->

                {% assign product_collection_name = blank %}
                {% assign product_collection_handle = blank %}


                {% for product_collection in product.collections %}

                  {% unless product_collection.handle == 'all-collections' %}

                    {% if product_collection.products_count > 0 %}

                      {% assign product_collection_name = product_collection.title %}
                      {% assign product_collection_handle = product_collection.handle %}

                      {% break %}

                    {% endif %}

                  {% endunless %}

                {% endfor %}


                {% if section.settings.show_collection_name
                  and product_collection_name != blank %}

                  <a
                    href="/collections/{{ product_collection_handle }}"
                    class="custom-product-card__collection"
                  >
                    {{ product_collection_name }}
                  </a>

                {% endif %}



                <!-- TITLE -->

                <a
                  href="{{ product.url }}"
                  class="custom-product-card__title"
                >
                  {{ product.title }}
                </a>



                <!-- DESCRIPTION -->

                {% if section.settings.show_description %}

                  <div class="custom-product-card__description">

                    {{
                      product.description
                      | strip_html
                      | truncatewords: section.settings.description_words
                    }}

                  </div>

                {% endif %}



                <!-- RATING -->

                {% if section.settings.show_rating %}

                  {% assign rating_value =
                    product.metafields.reviews.rating.value
                  %}


                  {% if rating_value != blank %}

                    <div class="custom-product-card__rating">

                      <span class="custom-product-card__stars">

                        {% assign rating_number =
                          rating_value.rating | round
                        %}


                        {% for i in (1..5) %}

                          {% if i <= rating_number %}
                            ★
                          {% else %}
                            ☆
                          {% endif %}

                        {% endfor %}

                      </span>


                      {% if product.metafields.reviews.rating_count.value != blank %}

                        <span class="custom-product-card__review-count">

                          {{ product.metafields.reviews.rating_count.value }}
                          recensioner

                        </span>

                      {% endif %}

                    </div>

                  {% endif %}

                {% endif %}



                <!-- PRICE -->

                <div class="custom-product-card__price">

                  {% if product.compare_at_price > product.price %}

                    <span class="custom-product-card__price-current">
                      {{ product.price | money }}
                    </span>

                    <span class="custom-product-card__price-old">
                      {{ product.compare_at_price | money }}
                    </span>

                  {% else %}

                    <span class="custom-product-card__price-current">
                      {{ product.price | money }}
                    </span>

                  {% endif %}

                </div>



                <!-- TYPE -->

                {% if section.settings.show_product_type
                  and product.type != blank %}

                  <div class="custom-product-card__type">
                    {{ product.type }}
                  </div>

                {% endif %}

              </div>

            </article>

          {% endif %}

        {% endfor %}


      </div>



      <!-- NO MANUAL PRODUCTS -->

      {% if manual_products_found == 0 %}

        <div class="custom-product-grid__empty">

          <h2>
            {{ section.settings.empty_title }}
          </h2>

          <p>
            {{ section.settings.empty_text }}
          </p>

        </div>

      {% endif %}



    {% else %}


      <!-- ========================================= -->
      <!-- NORMAL SHOPIFY SORTING -->
      <!-- ========================================= -->

      {% paginate current_collection.products by products_per_page %}


        {% if current_collection.products.size > 0 %}


          <div
            class="
              custom-product-grid__products
              custom-product-grid__products--{{ section.settings.desktop_columns }}
            "
          >


            {% for product in current_collection.products %}


              <!-- PRODUCT CARD -->

              <article class="custom-product-card">


                <!-- IMAGE -->

                <a
                  href="{{ product.url }}"
                  class="custom-product-card__image"
                >

                  {% if product.featured_image %}

                    {{
                      product.featured_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        widths: '300,400,500,600,700,800',
                        sizes: '(min-width: 990px) 25vw, 50vw',
                        class: 'custom-product-card__img',
                        alt: product.featured_image.alt | default: product.title
                    }}

                  {% else %}

                    {{ 'product-1'
                      | placeholder_svg_tag:
                      'custom-product-card__placeholder'
                    }}

                  {% endif %}


                  {% if section.settings.show_badges %}

                    <div class="custom-product-card__badges">

                      {% if product.tags contains 'Bestseller'
                        or product.tags contains 'BESTSELLER' %}

                        <span class="custom-product-card__badge">
                          Bestseller
                        </span>

                      {% elsif product.tags contains 'New'
                        or product.tags contains 'NEW' %}

                        <span class="custom-product-card__badge">
                          Ny
                        </span>

                      {% elsif product.compare_at_price > product.price %}

                        <span class="custom-product-card__badge">
                          Sale
                        </span>

                      {% endif %}

                    </div>

                  {% endif %}

                </a>



                <!-- CONTENT -->

                <div class="custom-product-card__content">


                  <!-- COLLECTION -->

                  {% assign product_collection_name = blank %}
                  {% assign product_collection_handle = blank %}


                  {% for product_collection in product.collections %}

                    {% unless product_collection.handle == 'all-collections' %}

                      {% if product_collection.products_count > 0 %}

                        {% assign product_collection_name = product_collection.title %}
                        {% assign product_collection_handle = product_collection.handle %}

                        {% break %}

                      {% endif %}

                    {% endunless %}

                  {% endfor %}


                  {% if section.settings.show_collection_name
                    and product_collection_name != blank %}

                    <a
                      href="/collections/{{ product_collection_handle }}"
                      class="custom-product-card__collection"
                    >
                      {{ product_collection_name }}
                    </a>

                  {% endif %}



                  <!-- TITLE -->

                  <a
                    href="{{ product.url }}"
                    class="custom-product-card__title"
                  >
                    {{ product.title }}
                  </a>



                  <!-- DESCRIPTION -->

                  {% if section.settings.show_description %}

                    <div class="custom-product-card__description">

                      {{
                        product.description
                        | strip_html
                        | truncatewords: section.settings.description_words
                      }}

                    </div>

                  {% endif %}



                  <!-- RATING -->

                  {% if section.settings.show_rating %}

                    {% assign rating_value =
                      product.metafields.reviews.rating.value
                    %}


                    {% if rating_value != blank %}

                      <div class="custom-product-card__rating">

                        <span class="custom-product-card__stars">

                          {% assign rating_number =
                            rating_value.rating | round
                          %}


                          {% for i in (1..5) %}

                            {% if i <= rating_number %}
                              ★
                            {% else %}
                              ☆
                            {% endif %}

                          {% endfor %}

                        </span>


                        {% if product.metafields.reviews.rating_count.value != blank %}

                          <span class="custom-product-card__review-count">

                            {{ product.metafields.reviews.rating_count.value }}
                            recensioner

                          </span>

                        {% endif %}

                      </div>

                    {% endif %}

                  {% endif %}



                  <!-- PRICE -->

                  <div class="custom-product-card__price">

                    {% if product.compare_at_price > product.price %}

                      <span class="custom-product-card__price-current">
                        {{ product.price | money }}
                      </span>

                      <span class="custom-product-card__price-old">
                        {{ product.compare_at_price | money }}
                      </span>

                    {% else %}

                      <span class="custom-product-card__price-current">
                        {{ product.price | money }}
                      </span>

                    {% endif %}

                  </div>



                  <!-- TYPE -->

                  {% if section.settings.show_product_type
                    and product.type != blank %}

                    <div class="custom-product-card__type">
                      {{ product.type }}
                    </div>

                  {% endif %}

                </div>

              </article>


            {% endfor %}

          </div>



          <!-- PAGINATION -->

          {% if paginate.pages > 1 %}

            <div class="custom-product-grid__pagination">


              {% if paginate.previous %}

                <a
                  href="{{ paginate.previous.url }}"
                  class="custom-product-grid__pagination-arrow"
                  data-ajax-filter
                >
                  ←
                </a>

              {% endif %}


              {% for part in paginate.parts %}

                {% if part.is_link %}

                  <a
                    href="{{ part.url }}"
                    class="custom-product-grid__pagination-number"
                    data-ajax-filter
                  >
                    {{ part.title }}
                  </a>

                {% else %}

                  <span
                    class="
                      custom-product-grid__pagination-number
                      {% if part.title == paginate.current_page %}
                        is-current
                      {% endif %}
                    "
                  >
                    {{ part.title }}
                  </span>

                {% endif %}

              {% endfor %}


              {% if paginate.next %}

                <a
                  href="{{ paginate.next.url }}"
                  class="custom-product-grid__pagination-arrow"
                  data-ajax-filter
                >
                  →
                </a>

              {% endif %}


            </div>

          {% endif %}


        {% else %}


          <div class="custom-product-grid__empty">

            <h2>
              {{ section.settings.empty_title }}
            </h2>

            <p>
              {{ section.settings.empty_text }}
            </p>

          </div>


        {% endif %}


      {% endpaginate %}

    {% endif %}



    <!-- BOTTOM BUTTON -->

    {% if section.settings.show_bottom_button %}

      <div class="custom-product-grid__bottom">

        <a
          href="{{ routes.all_products_collection_url }}"
          class="custom-product-grid__button"
        >
          {{ section.settings.button_text }}
        </a>

      </div>

    {% endif %}


  </div>

</section>



<style>

#CustomProductGrid-{{ section.id }} {
  width: 100%;
  background: var(--cpg-bg);
  color: var(--cpg-text);
  padding-top: var(--cpg-top-padding);
  padding-bottom: var(--cpg-bottom-padding);
}


#CustomProductGrid-{{ section.id }} *,
#CustomProductGrid-{{ section.id }} *::before,
#CustomProductGrid-{{ section.id }} *::after {
  box-sizing: border-box;
}


#CustomProductGrid-{{ section.id }} .custom-product-grid__container {
  width: 100%;
  max-width: var(--cpg-max-width);
  margin: 0 auto;
  padding-left: 20px;
  padding-right: 20px;
}


/* TOP */

#CustomProductGrid-{{ section.id }} .custom-product-grid__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 12px;
}


/* COUNT */

#CustomProductGrid-{{ section.id }} .custom-product-grid__count {
  font-size: {{ section.settings.count_font_size }}px;
  color: var(--cpg-text);
  line-height: 1.4;
}


/* CONTROLS */

#CustomProductGrid-{{ section.id }} .custom-product-grid__controls {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
}


/* DROPDOWN */

#CustomProductGrid-{{ section.id }} .custom-product-grid__dropdown {
  position: relative;
}


/* SELECT */

#CustomProductGrid-{{ section.id }} .custom-product-grid__select {
  min-width: 126px;
  height: 38px;

  padding: 0 12px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  border: 1px solid var(--cpg-border);

  background: transparent;

  color: var(--cpg-text);

  font-size: {{ section.settings.control_font_size }}px;

  line-height: 1;

  cursor: pointer;

  list-style: none;

  user-select: none;
}


#CustomProductGrid-{{ section.id }} .custom-product-grid__select::-webkit-details-marker {
  display: none;
}


#CustomProductGrid-{{ section.id }} .custom-product-grid__select svg {
  flex: 0 0 auto;
  transition: transform .2s ease;
}


#CustomProductGrid-{{ section.id }} details[open] > .custom-product-grid__select svg {
  transform: rotate(180deg);
}


/* DROPDOWN MENU */

#CustomProductGrid-{{ section.id }} .custom-product-grid__dropdown-menu {
  position: absolute;

  z-index: 999;

  top: calc(100% + 5px);

  right: 0;

  width: 230px;

  max-height: 400px;

  overflow-y: auto;

  background: var(--cpg-card-bg);

  border: 1px solid var(--cpg-border);

  box-shadow: 0 8px 25px rgba(0, 0, 0, .08);

  padding: 8px;
}


/* CATEGORY OPTION */

#CustomProductGrid-{{ section.id }} .custom-product-grid__collection-option {
  display: flex;

  align-items: center;

  justify-content: space-between;

  width: 100%;

  min-height: 36px;

  padding: 8px 9px;

  color: var(--cpg-text);

  text-decoration: none;

  font-size: 11px;

  line-height: 1.3;

  cursor: pointer;
}


#CustomProductGrid-{{ section.id }} .custom-product-grid__collection-option:hover,
#CustomProductGrid-{{ section.id }} .custom-product-grid__collection-option.is-active {
  background: rgba(0, 0, 0, .04);
}


#CustomProductGrid-{{ section.id }} .custom-product-grid__collection-count {
  margin-left: auto;

  margin-right: 8px;

  color: var(--cpg-muted);

  font-size: 9px;
}


#CustomProductGrid-{{ section.id }} .custom-product-grid__check {
  font-size: 11px;

  line-height: 1;
}


/* SORT OPTION */

#CustomProductGrid-{{ section.id }} .custom-product-grid__sort-menu {
  width: 220px;
}


#CustomProductGrid-{{ section.id }} .custom-product-grid__sort-option {
  display: flex;

  align-items: center;

  justify-content: space-between;

  width: 100%;

  padding: 10px 8px;

  color: var(--cpg-text);

  text-decoration: none;

  font-size: 11px;

  line-height: 1.3;

  cursor: pointer;
}


#CustomProductGrid-{{ section.id }} .custom-product-grid__sort-option:hover,
#CustomProductGrid-{{ section.id }} .custom-product-grid__sort-option.is-active {
  background: rgba(0, 0, 0, .04);
}


/* GRID */

#CustomProductGrid-{{ section.id }} .custom-product-grid__products {
  display: grid;

  grid-template-columns: repeat(4, minmax(0, 1fr));

  column-gap: var(--cpg-grid-gap);

  row-gap: 30px;
}


/* CARD */

#CustomProductGrid-{{ section.id }} .custom-product-card {
  min-width: 0;
}


/* IMAGE */

#CustomProductGrid-{{ section.id }} .custom-product-card__image {
  position: relative;

  display: block;

  width: 100%;

  aspect-ratio: 1 / 1;

  overflow: hidden;

  background: var(--cpg-card-bg);

  text-decoration: none;
}


#CustomProductGrid-{{ section.id }} .custom-product-card__img {
  display: block;

  width: 100%;

  height: 100%;

  object-fit: contain;

  transition: transform .35s ease;
}


