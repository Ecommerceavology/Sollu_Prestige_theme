<script>

(function () {

  const SECTION_ID = '{{ section.id }}';


  /*
   * Prevent duplicate global initialization.
   */

  if (window.CustomProductGridAjax) {
    return;
  }

  window.CustomProductGridAjax = true;



  /*
   * GET CURRENT GRID
   */

  function getGrid() {

    return document.querySelector(
      '#CustomProductGrid-' + SECTION_ID
    );

  }



  /*
   * CLOSE DROPDOWNS
   */

  function closeDropdowns() {

    const grid = getGrid();

    if (!grid) {
      return;
    }


    grid
      .querySelectorAll(
        'details.custom-product-grid__dropdown'
      )
      .forEach(function (dropdown) {

        dropdown.removeAttribute('open');

      });

  }



  /*
   * CREATE AJAX SECTION URL
   */

  function getAjaxUrl(url) {

    const parsedUrl = new URL(
      url,
      window.location.origin
    );


    parsedUrl.searchParams.set(
      'section_id',
      SECTION_ID
    );


    return parsedUrl.toString();

  }



  /*
   * LOAD FILTER WITH AJAX
   */

  async function loadFilter(url, updateHistory) {

    const grid = getGrid();

    if (!grid) {
      return;
    }


    if (grid.classList.contains('is-loading')) {
      return;
    }


    grid.classList.add('is-loading');

    closeDropdowns();


    try {

      /*
       * IMPORTANT:
       *
       * URL example:
       *
       * /collections/glow-therapy
       *
       * or:
       *
       * /collections/glow-therapy?sort_by=price-ascending
       *
       * Shopify receives the collection and
       * sort_by together.
       */

      const ajaxUrl = getAjaxUrl(url);


      const response = await fetch(
        ajaxUrl,
        {
          method: 'GET',

          credentials: 'same-origin',

          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        }
      );


      if (!response.ok) {

        throw new Error(
          'AJAX request failed'
        );

      }


      const html = await response.text();


      const parser = new DOMParser();


      const documentHTML =
        parser.parseFromString(
          html,
          'text/html'
        );


      const newGrid =
        documentHTML.querySelector(
          '#CustomProductGrid-' + SECTION_ID
        );


      if (!newGrid) {

        throw new Error(
          'Product grid was not found'
        );

      }


      /*
       * Replace ONLY our custom section.
       */

      grid.replaceWith(newGrid);


      /*
       * Update browser URL.
       */

      if (updateHistory) {

        window.history.pushState(
          {
            customProductGrid: true
          },

          '',

          url
        );

      }


    } catch (error) {

      console.error(
        'Custom Product Grid AJAX Error:',
        error
      );


      /*
       * Fallback to normal navigation.
       */

      window.location.href = url;

      return;

    }


    const updatedGrid = getGrid();

    if (updatedGrid) {

      updatedGrid.classList.remove(
        'is-loading'
      );

    }

  }



  /*
   * FILTER CLICK
   *
   * Event delegation means this continues
   * working after AJAX replacement.
   */

  document.addEventListener(
    'click',
    function (event) {

      const link =
        event.target.closest(
          '#CustomProductGrid-' +
          SECTION_ID +
          ' a[data-ajax-filter]'
        );


      if (!link) {
        return;
      }


      /*
       * Allow normal browser behavior for
       * modifier clicks.
       */

      if (
        event.ctrlKey ||
        event.metaKey ||
        event.shiftKey ||
        event.altKey ||
        event.button !== 0
      ) {

        return;

      }


      const url = link.href;

      if (!url) {
        return;
      }


      const parsedUrl =
        new URL(
          url,
          window.location.origin
        );


      /*
       * Same-origin only.
       */

      if (
        parsedUrl.origin !==
        window.location.origin
      ) {

        return;

      }


      event.preventDefault();


      loadFilter(
        parsedUrl.toString(),
        true
      );

    }
  );



  /*
   * CLOSE WHEN CLICKING OUTSIDE
   */

  document.addEventListener(
    'click',
    function (event) {

      const grid = getGrid();

      if (!grid) {
        return;
      }


      if (!grid.contains(event.target)) {

        closeDropdowns();

        return;

      }


      const dropdown =
        event.target.closest(
          'details.custom-product-grid__dropdown'
        );


      if (!dropdown) {

        closeDropdowns();

      }

    }
  );



  /*
   * ONLY ONE DROPDOWN OPEN
   */

  document.addEventListener(
    'toggle',
    function (event) {

      const dropdown = event.target;


      if (
        !dropdown.matches ||
        !dropdown.matches(
          '#CustomProductGrid-' +
          SECTION_ID +
          ' details.custom-product-grid__dropdown'
        )
      ) {

        return;

      }


      if (!dropdown.open) {
        return;
      }


      const grid = getGrid();

      if (!grid) {
        return;
      }


      grid
        .querySelectorAll(
          'details.custom-product-grid__dropdown'
        )
        .forEach(function (otherDropdown) {

          if (
            otherDropdown !== dropdown
          ) {

            otherDropdown.removeAttribute(
              'open'
            );

          }

        });

    },

    true
  );



  /*
   * ESCAPE
   */

  document.addEventListener(
    'keydown',
    function (event) {

      if (event.key === 'Escape') {

        closeDropdowns();

      }

    }
  );



  /*
   * BROWSER BACK / FORWARD
   */

  window.addEventListener(
    'popstate',
    function () {

      loadFilter(
        window.location.href,
        false
      );

    }
  );

})();

</script>



