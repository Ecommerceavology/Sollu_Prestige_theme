{% comment %}
  Dynamic Specifications Table
  File: sections/specifications-table.liquid
{% endcomment %}

<section
  class="specifications-table-section section-{{ section.id }}"
  {% if section.settings.custom_class != blank %}
    class="{{ section.settings.custom_class }}"
  {% endif %}
>
  <div class="specifications-table-wrapper">

    {% if section.settings.small_heading != blank %}
      <div class="specifications-small-heading">
        {{ section.settings.small_heading }}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="specifications-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="specifications-table">

      <!-- TABLE HEADER -->
      <div class="specifications-row specifications-header">
        <div class="specifications-label">
          {{ section.settings.specification_label }}
        </div>

        <div class="specifications-value">
          {{ section.settings.value_label }}
        </div>
      </div>

      <!-- DYNAMIC ROWS -->
      {% for block in section.blocks %}
        {% if block.type == 'specification' %}

          <div
            class="specifications-row"
            {{ block.shopify_attributes }}
          >
            <div class="specifications-label">
              {{ block.settings.specification }}
            </div>

            <div class="specifications-value">
              {{ block.settings.value }}
            </div>
          </div>

        {% endif %}
      {% endfor %}

    </div>

  </div>
</section>


<style>
  .section-{{ section.id }} {
    width: 100%;
  }

  .section-{{ section.id }} .specifications-table-wrapper {
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* Small heading */
  .section-{{ section.id }} .specifications-small-heading {
    margin-bottom: 10px;

    color: {{ section.settings.small_heading_color }};

    font-size: {{ section.settings.small_heading_size }}px;
    line-height: 1.5;

    font-weight: 400;

    letter-spacing: {{ section.settings.small_heading_spacing }}px;

    text-transform: uppercase;
  }

  /* Main heading */
  .section-{{ section.id }} .specifications-heading {
    margin: 0 0 8px;

    color: {{ section.settings.heading_color }};

    font-size: {{ section.settings.heading_size }}px;
    line-height: 1.4;

    font-weight: 500;

    letter-spacing: {{ section.settings.heading_spacing }}px;

    text-transform: uppercase;
  }

  /* Table */
  .section-{{ section.id }} .specifications-table {
    width: 100%;

    border-top: 1px solid {{ section.settings.border_color }};
    border-left: 1px solid {{ section.settings.border_color }};
  }

  /* Every row */
  .section-{{ section.id }} .specifications-row {
    display: grid;

    grid-template-columns:
      {{ section.settings.label_width }}px
      minmax(0, 1fr);

    width: 100%;
  }

  /* Header */
  .section-{{ section.id }} .specifications-header {
    background: {{ section.settings.header_background }};
    color: {{ section.settings.header_text_color }};
  }

  .section-{{ section.id }} .specifications-header > div {
    padding:
      {{ section.settings.header_vertical_padding }}px
      {{ section.settings.horizontal_padding }}px;

    font-size: {{ section.settings.header_font_size }}px;
    line-height: 1.4;

    font-weight: 500;

    text-transform: uppercase;
  }

  /* Normal cells */
  .section-{{ section.id }} .specifications-row:not(.specifications-header) > div {
    padding:
      {{ section.settings.row_vertical_padding }}px
      {{ section.settings.horizontal_padding }}px;

    background: {{ section.settings.row_background }};

    color: {{ section.settings.text_color }};

    font-size: {{ section.settings.font_size }}px;
    line-height: {{ section.settings.line_height }}px;

    border-right: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
  }

  /* Header borders */
  .section-{{ section.id }} .specifications-header > div {
    border-right: 1px solid {{ section.settings.header_background }};
    border-bottom: 1px solid {{ section.settings.header_background }};
  }

  /* Label column */
  .section-{{ section.id }} .specifications-label {
    font-weight: {{ section.settings.label_font_weight }};
  }

  /* Value column */
  .section-{{ section.id }} .specifications-value {
    font-weight: 400;
  }

  /* Last header column */
  .section-{{ section.id }} .specifications-header .specifications-value {
    border-right: 1px solid {{ section.settings.header_background }};
  }


  /* ==========================
     MOBILE
     ========================== */

  @media screen and (max-width: 749px) {

    .section-{{ section.id }} .specifications-table-wrapper {
      max-width: 100%;
    }

    .section-{{ section.id }} .specifications-row {
      grid-template-columns:
        {{ section.settings.mobile_label_width }}%
        minmax(0, 1fr);
    }

    .section-{{ section.id }} .specifications-small-heading {
      font-size: {{ section.settings.mobile_small_heading_size }}px;
    }

    .section-{{ section.id }} .specifications-heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .section-{{ section.id }} .specifications-header > div {
      padding:
        {{ section.settings.mobile_header_vertical_padding }}px
        {{ section.settings.mobile_horizontal_padding }}px;

      font-size: {{ section.settings.mobile_header_font_size }}px;
    }

    .section-{{ section.id }} .specifications-row:not(.specifications-header) > div {
      padding:
        {{ section.settings.mobile_row_vertical_padding }}px
        {{ section.settings.mobile_horizontal_padding }}px;

      font-size: {{ section.settings.mobile_font_size }}px;
      line-height: {{ section.settings.mobile_line_height }}px;
    }
  }
</style>


