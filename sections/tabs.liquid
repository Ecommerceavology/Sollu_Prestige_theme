{%- if section.blocks.size > 0 -%}

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  <div class="
    section-spacing
    color-scheme
    color-scheme--{{ section.settings.color_scheme.id }}
    color-scheme--bg-{{ color_scheme_hash }}
    {% if section.settings.separate_section_with_border %}bordered-section{% endif %}
    {% if section.settings.custom_class != blank %}{{ section.settings.custom_class }}{% endif %}
  ">

    <div class="container {% if section.settings.text_alignment == 'center' %}container--xl{% endif %}">

      <div class="section-stack">

        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.title,
          heading_style: section.settings.heading_style,
          content: section.settings.content,
          text_alignment: section.settings.text_alignment
        -%}


        <!-- ==========================================
             DESKTOP TABS
        =========================================== -->

        <x-tabs class="content-tabs {% if section.settings.text_alignment == 'center' %}content-tabs--center{% endif %} hidden sm:block">

          <template shadowrootmode="open">
            <slot role="tablist" part="tab-list" name="title"></slot>
            <slot part="tab-panel-list" name="content"></slot>
          </template>


          {%- for block in section.blocks -%}

            {%- liquid

              assign title = block.settings.page.title | default: block.settings.title

              assign content = ''

              if block.type == 'tab'
                assign content = block.settings.page.content | default: block.settings.content

              elsif block.type == 'liquid'
                assign content = block.settings.liquid

              elsif block.type == 'specifications'

              

                assign content = product.metafields.custom.technical_specifications.value

                if content == blank
                  assign title = ''
                endif

              endif

            -%}


            {%- if title != blank and content != blank -%}

              <!-- ==========================================
                   TAB TITLE
              =========================================== -->

              <button
                class="h6"
                type="button"
                role="tab"
                slot="title"
                {{ block.shopify_attributes }}
              >
                {{ title }}
              </button>


              <!-- ==========================================
                   TAB CONTENT
              =========================================== -->

              <div
                role="tabpanel"
                slot="content"
                {% cycle '', 'hidden', 'hidden', 'hidden', 'hidden' %}
              >


                {% if block.type == 'specifications' %}

                  <!-- ==========================================
                       SPECIFICATIONS BLOCK
                  =========================================== -->

                  <div
                    class="prose specifications-tab-content{% if block.settings.custom_class != blank %} {{ block.settings.custom_class }}{% endif %}"
                  >


                    {% if block.settings.small_heading != blank %}

                      <div class="specifications-small-heading">
                        {{ block.settings.small_heading }}
                      </div>

                    {% endif %}


                    {% if block.settings.heading != blank %}

                      <h3 class="specifications-heading">
                        {{ block.settings.heading }}
                      </h3>

                    {% endif %}


                    <div class="specifications-table">


                      <!-- ==========================================
                           TABLE HEADER
                      =========================================== -->

                      <div class="specifications-row specifications-header">

                        <div class="specifications-label">
                          {{ block.settings.specification_heading }}
                        </div>

                        <div class="specifications-value">
                          {{ block.settings.value_heading }}
                        </div>

                      </div>


                      <!-- ==========================================
                           METAFIELD CONTENT
                      =========================================== -->

                      {% assign specification_html = product.metafields.custom.technical_specifications.value %}


                      {% if specification_html != blank %}

                        {% assign specification_items = specification_html | split: '<li' %}


                        {% for item in specification_items %}

                          {% if item contains '<strong>' %}

                            {% assign item_content = item | split: '</li>' | first %}


                            <!-- GET LABEL -->

                            {% assign specification_name = item_content
                              | split: '<strong>'
                              | last
                              | split: '</strong>'
                              | first
                            %}


                            <!-- GET VALUE -->

                            {% assign specification_value = item_content
                              | split: '</strong>'
                              | last
                            %}


                            <!-- CLEAN LABEL -->

                            {% assign specification_name = specification_name
                              | strip_html
                              | strip
                            %}


                            {% assign specification_name = specification_name
                              | remove_first: ':'
                              | strip
                            %}


                            <!-- CLEAN VALUE -->

                            {% assign specification_value = specification_value
                              | strip_html
                              | strip
                            %}


                            {% if specification_name != blank %}

                              <div class="specifications-row">

                                <div class="specifications-label">
                                  <strong>
                                    {{ specification_name }}
                                  </strong>
                                </div>

                                <div class="specifications-value">
                                  {{ specification_value }}
                                </div>

                              </div>

                            {% endif %}

                          {% endif %}

                        {% endfor %}

                      {% endif %}


                    </div>

                  </div>


                {% else %}

                  <!-- ==========================================
                       NORMAL TAB
                  =========================================== -->

                  <div class="prose">
                    {{- content -}}
                  </div>

                {% endif %}


              </div>

            {%- endif -%}

          {%- endfor -%}

        </x-tabs>



        <!-- ==========================================
             MOBILE
        =========================================== -->

        <div class="accordion-group sm:hidden">

          {%- for block in section.blocks -%}

            {%- liquid

              assign title = block.settings.page.title | default: block.settings.title

              assign content = ''

              if block.type == 'tab'
                assign content = block.settings.page.content | default: block.settings.content

              elsif block.type == 'liquid'
                assign content = block.settings.liquid

              elsif block.type == 'specifications'

                assign content = product.metafields.custom.technical_specifications.value

                if content == blank
                  assign title = ''
                endif

              endif

            -%}


            {%- if title != blank and content != blank -%}


              {% if block.type == 'specifications' %}


                <!-- ==========================================
                     MOBILE SPECIFICATIONS
                =========================================== -->

                {%- capture specifications_content -%}

                  <div
                    class="prose specifications-tab-content{% if block.settings.custom_class != blank %} {{ block.settings.custom_class }}{% endif %}"
                  >


                    {% if block.settings.small_heading != blank %}

                      <div class="specifications-small-heading">
                        {{ block.settings.small_heading }}
                      </div>

                    {% endif %}


                    {% if block.settings.heading != blank %}

                      <h3 class="specifications-heading">
                        {{ block.settings.heading }}
                      </h3>

                    {% endif %}


                    <div class="specifications-table">


                      <!-- HEADER -->

                      <div class="specifications-row specifications-header">

                        <div class="specifications-label">
                          {{ block.settings.specification_heading }}
                        </div>

                        <div class="specifications-value">
                          {{ block.settings.value_heading }}
                        </div>

                      </div>


                      <!-- METAFIELD -->

                      {% assign specification_html = product.metafields.custom.technical_specifications.value %}


                      {% if specification_html != blank %}

                        {% assign specification_items = specification_html | split: '<li' %}


                        {% for item in specification_items %}

                          {% if item contains '<strong>' %}

                            {% assign item_content = item | split: '</li>' | first %}


                            {% assign specification_name = item_content
                              | split: '<strong>'
                              | last
                              | split: '</strong>'
                              | first
                            %}


                            {% assign specification_value = item_content
                              | split: '</strong>'
                              | last
                            %}


                            {% assign specification_name = specification_name
                              | strip_html
                              | strip
                            %}


                            {% assign specification_name = specification_name
                              | remove_first: ':'
                              | strip
                            %}


                            {% assign specification_value = specification_value
                              | strip_html
                              | strip
                            %}


                            {% if specification_name != blank %}

                              <div class="specifications-row">

                                <div class="specifications-label">
                                  <strong>
                                    {{ specification_name }}
                                  </strong>
                                </div>

                                <div class="specifications-value">
                                  {{ specification_value }}
                                </div>

                              </div>

                            {% endif %}

                          {% endif %}

                        {% endfor %}

                      {% endif %}


                    </div>

                  </div>

                {%- endcapture -%}


                {%- render 'accordion',
                  title: title,
                  content: specifications_content,
                  open: block.settings.open_on_mobile,
                  prose_content: true
                -%}


              {% else %}


                <!-- NORMAL MOBILE TAB -->

                {%- render 'accordion',
                  title: title,
                  content: content,
                  open: block.settings.open_on_mobile,
                  prose_content: true
                -%}


              {% endif %}


            {%- endif -%}

          {%- endfor -%}

        </div>

      </div>

    </div>

  </div>

{%- endif -%}



<!-- ==========================================
     SPECIFICATIONS CSS
========================================== -->

<style>

  .specifications-tab-content {
    width: 100%;
  }


  /* ==========================================
     SMALL HEADING
  =========================================== */

  .specifications-tab-content .specifications-small-heading {

    margin-bottom: 10px;

    color: #b57b32;

    font-size: 12px;

    line-height: 1.5;

    font-weight: 400;

    letter-spacing: 4px;

    text-transform: uppercase;

  }


  /* ==========================================
     MAIN HEADING
  =========================================== */

  .specifications-tab-content .specifications-heading {

    margin: 0 0 8px;

    color: #b57b32;

    font-size: 15px;

    line-height: 1.4;

    font-weight: 500;

    letter-spacing: 3px;

    text-transform: uppercase;

  }


  /* ==========================================
     TABLE
  =========================================== */

  .specifications-tab-content .specifications-table {

    width: 100%;

    margin: 0;

    border-top: 1px solid #ded4c8;

    border-left: 1px solid #ded4c8;

  }


  /* ==========================================
     ROW
  =========================================== */

  .specifications-tab-content .specifications-row {

    display: grid;

    grid-template-columns: 225px minmax(0, 1fr);

    width: 100%;

    margin: 0 !important;

    padding: 0 !important;

  }


  /* ==========================================
     HEADER
  =========================================== */

  .specifications-tab-content .specifications-header {

    background: #29231f;

  }


  .specifications-tab-content .specifications-header > div {

    box-sizing: border-box;

    padding: 4px 10px;

    color: #ffffff;

    font-size: 11px;

    line-height: 16px;

    font-weight: 500;

    text-transform: uppercase;

    border-right: 1px solid #29231f;

    border-bottom: 1px solid #29231f;

  }


  /* ==========================================
     BODY ROWS
  =========================================== */

  .specifications-tab-content
  .specifications-row:not(.specifications-header)
  > div {

    box-sizing: border-box;

    min-width: 0;

    padding: 3px 10px;

    background: #f5f0e9;

    color: #2c2521;

    font-size: 13px;

    line-height: 18px;

    font-weight: 400;

    border-right: 1px solid #ded4c8;

    border-bottom: 1px solid #ded4c8;

    overflow-wrap: break-word;

  }


  /* ==========================================
     LEFT COLUMN
  =========================================== */

  .specifications-tab-content
  .specifications-row:not(.specifications-header)
  .specifications-label {

    color: #211d1a;

    font-weight: 700;

  }


  .specifications-tab-content
  .specifications-row:not(.specifications-header)
  .specifications-label strong {

    color: #211d1a;

    font-weight: 700;

  }


  /* ==========================================
     RIGHT COLUMN
  =========================================== */

  .specifications-tab-content
  .specifications-row:not(.specifications-header)
  .specifications-value {

    font-weight: 400;

  }


  /* ==========================================
     MOBILE
  =========================================== */

  @media screen and (max-width: 749px) {

    .specifications-tab-content
    .specifications-small-heading {

      font-size: 11px;

      letter-spacing: 3px;

    }


    .specifications-tab-content
    .specifications-heading {

      font-size: 14px;

      letter-spacing: 2px;

    }


    .specifications-tab-content
    .specifications-row {

      grid-template-columns: 38% minmax(0, 62%);

    }


    .specifications-tab-content
    .specifications-header
    > div {

      padding: 4px 7px;

      font-size: 10px;

      line-height: 15px;

    }


    .specifications-tab-content
    .specifications-row:not(.specifications-header)
    > div {

      padding: 4px 7px;

      font-size: 12px;

      line-height: 17px;

    }

  }

</style>



{% schema %}

{
  "name": "t:sections.tabs.name",

  "class": "shopify-section--tabs",

  "max_blocks": 5,

  "disabled_on": {
    "groups": [
      "header",
      "custom.overlay"
    ]
  },

  "settings": [

    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class",
      "info": "Add a custom CSS class to this section."
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },

    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },

    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading",
      "default": "Subheading"
    },

    {
      "type": "inline_richtext",
      "id": "title",
      "label": "t:global.text.heading",
      "default": "Heading"
    },

    {
      "type": "select",
      "id": "heading_style",
      "label": "t:global.text.style",

      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],

      "default": "h2"
    },

    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:global.text.alignment",

      "options": [
        {
          "value": "start",
          "label": "t:global.position.left"
        },
        {
          "value": "center",
          "label": "t:global.position.center"
        }
      ],

      "default": "center"
    }

  ],


  "blocks": [

    {
      "type": "tab",

      "name": "t:sections.tabs.blocks.tab.name",

      "settings": [

        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:global.text.title",
          "default": "Tab"
        },

        {
          "type": "richtext",
          "id": "content",
          "label": "t:global.text.content",

          "default": "<p>Use this text to share information about your brand with your customers. Describe a product, share announcements, or welcome customers to your store.</p>"
        },

        {
          "type": "page",
          "id": "page",
          "label": "t:sections.tabs.blocks.tab.page",
          "info": "t:sections.tabs.blocks.tab.page_info"
        },

        {
          "type": "checkbox",
          "id": "open_on_mobile",
          "label": "t:sections.tabs.blocks.tab.open_on_mobile",
          "info": "t:sections.tabs.blocks.tab.open_on_mobile_info",
          "default": false
        }

      ]

    },


    {
      "type": "liquid",

      "name": "t:sections.tabs.blocks.liquid.name",

      "settings": [

        {
          "type": "inline_richtext",
          "id": "title",
          "label": "t:global.text.title",
          "default": "Tab"
        },

        {
          "type": "liquid",
          "id": "liquid",
          "label": "t:global.code.liquid",

          "default": "<p>Use Liquid code to create advanced customization.</p>"
        },

        {
          "type": "checkbox",
          "id": "open_on_mobile",
          "label": "t:sections.tabs.blocks.tab.open_on_mobile",
          "info": "t:sections.tabs.blocks.tab.open_on_mobile_info",
          "default": false
        }

      ]

    },


    {
      "type": "specifications",

      "name": "Specifications",

      "settings": [

        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Tab title",
          "default": "SPECIFIKATIONER"
        },

        {
          "type": "text",
          "id": "small_heading",
          "label": "Small heading",
          "default": "TEKNISKE SPECIFIKATIONER"
        },

        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "SPECS – TIL PRODUKTSIDE OG SEO"
        },

        {
          "type": "text",
          "id": "specification_heading",
          "label": "Specification column heading",
          "default": "SPECIFIKATION"
        },

        {
          "type": "text",
          "id": "value_heading",
          "label": "Value column heading",
          "default": "VÆRDI"
        },

        {
          "type": "text",
          "id": "custom_class",
          "label": "Custom class",
          "info": "Optional custom CSS class for this Specifications block."
        },

        {
          "type": "checkbox",
          "id": "open_on_mobile",
          "label": "Open on mobile",
          "default": false
        }

      ]

    }

  ],


  "presets": [

    {
      "name": "t:sections.tabs.presets.tab.name",

      "category": "t:global.categories.content",

      "blocks": [

        {
          "type": "tab",

          "settings": {
            "title": "Tab 1",
            "content": "<p>Use this text to share information about your brand with your customers.</p>"
          }

        },

        {
          "type": "tab",

          "settings": {
            "title": "Tab 2",
            "content": "<p>Describe a product, share announcements, or welcome customers to your store.</p>"
          }

        },

        {
          "type": "tab",

          "settings": {
            "title": "Tab 3",
            "content": "<p>Share information about your shipping rates, return policy or contact information.</p>"
          }

        }

      ]

    }

  ]

}

{% endschema %}