{%- comment -%}
  ====================================================================================================
  DVB FEATURED PRODUCTS
  Independent featured product section

  All custom classes, settings and block IDs use the "dvb_fp_" namespace
  to avoid conflicts with existing theme sections.
  ====================================================================================================
{%- endcomment -%}


{%- comment -%}
  ====================================================================================================
  STYLES
  ====================================================================================================
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} .dvb-fp {
    --dvb-fp-columns-mobile: {{ section.settings.dvb_fp_products_per_row_mobile }};
    --dvb-fp-columns-desktop: {{ section.settings.dvb_fp_products_per_row_desktop }};
    --dvb-fp-horizontal-gap: {{ section.settings.dvb_fp_horizontal_gap }}px;
    --dvb-fp-vertical-gap: {{ section.settings.dvb_fp_vertical_gap }}px;
  }

  #shopify-section-{{ section.id }} .dvb-fp__grid {
    display: grid;
    grid-template-columns: repeat(var(--dvb-fp-columns-mobile), minmax(0, 1fr));
    column-gap: var(--dvb-fp-horizontal-gap);
    row-gap: var(--dvb-fp-vertical-gap);
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .dvb-fp__grid {
      grid-template-columns: repeat(var(--dvb-fp-columns-desktop), minmax(0, 1fr));
    }
  }


  /* -----------------------------------------------------------------------------------------------
     Product card
     ----------------------------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .dvb-fp__card {
    min-width: 0;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .dvb-fp__image-link {
    display: block;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .dvb-fp__image-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .dvb-fp__image {
    display: block;
    width: 100%;
    height: auto;
  }

  #shopify-section-{{ section.id }} .dvb-fp__info {
    display: flex;
    flex-direction: column;
    align-items: center;
  }


  /* -----------------------------------------------------------------------------------------------
     Category
     ----------------------------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .dvb-fp__category {
    margin-top: 12px;
  }


  /* -----------------------------------------------------------------------------------------------
     Product title
     ----------------------------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .dvb-fp__title {
    display: inline-block;
    margin-top: 6px;
    text-decoration: none;
  }


  /* -----------------------------------------------------------------------------------------------
     Product highlights
     ----------------------------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .dvb-fp__highlights {
    margin-top: 6px;
  }


  /* -----------------------------------------------------------------------------------------------
     Rating
     ----------------------------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .dvb-fp__rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 6px;
  }

  #shopify-section-{{ section.id }} .dvb-fp__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .dvb-fp__star {
    position: relative;
    display: inline-block;
    width: 15px;
    height: 15px;
    font-size: 15px;
    line-height: 15px;
  }

  #shopify-section-{{ section.id }} .dvb-fp__star--full {
    color: currentColor;
  }

  #shopify-section-{{ section.id }} .dvb-fp__star--empty {
    color: currentColor;
    opacity: 0.2;
  }

  #shopify-section-{{ section.id }} .dvb-fp__star--half {
    color: currentColor;
  }

  #shopify-section-{{ section.id }} .dvb-fp__star--half::after {
    content: "★";
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
    color: currentColor;
  }

  #shopify-section-{{ section.id }} .dvb-fp__rating-number {
    font-size: 12px;
    line-height: 1;
  }


  /* -----------------------------------------------------------------------------------------------
     Price
     ----------------------------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .dvb-fp__price {
    margin-top: 7px;
  }


  /* -----------------------------------------------------------------------------------------------
     CTA
     ----------------------------------------------------------------------------------------------- */

  #shopify-section-{{ section.id }} .dvb-fp__cta {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }


  /* -----------------------------------------------------------------------------------------------
     Mobile
     ----------------------------------------------------------------------------------------------- */

  @media screen and (max-width: 699px) {
    #shopify-section-{{ section.id }} .dvb-fp__grid {
      column-gap: var(--dvb-fp-horizontal-gap);
      row-gap: var(--dvb-fp-vertical-gap);
    }

    #shopify-section-{{ section.id }} .dvb-fp__star {
      width: 14px;
      height: 14px;
      font-size: 14px;
      line-height: 14px;
    }
  }
</style>


{%- comment -%}
  ====================================================================================================
  SECTION
  ====================================================================================================
{%- endcomment -%}

<div
  class="
    dvb-fp
    section-spacing
    color-scheme
    color-scheme--{{ section.settings.dvb_fp_color_scheme.id }}
    {% if section.settings.dvb_fp_custom_class != blank %}
      {{ section.settings.dvb_fp_custom_class }}
    {% endif %}
  "
>

  <div class="container">


    {%- comment -%}
      ==================================================================================================
      SECTION HEADER
      ==================================================================================================
    {%- endcomment -%}

    {%- if section.settings.dvb_fp_subheading != blank or section.settings.dvb_fp_heading != blank -%}

      <div class="dvb-fp__header">

        {%- if section.settings.dvb_fp_subheading != blank -%}
          <p class="dvb-fp__subheading">
            {{ section.settings.dvb_fp_subheading }}
          </p>
        {%- endif -%}


        {%- if section.settings.dvb_fp_heading != blank -%}
          <h2 class="dvb-fp__heading">
            {{ section.settings.dvb_fp_heading }}
          </h2>
        {%- endif -%}

      </div>

    {%- endif -%}


    {%- comment -%}
      ==================================================================================================
      CHECK WHETHER THERE ARE ANY PRODUCTS
      ==================================================================================================
    {%- endcomment -%}

    {%- assign dvb_fp_has_products = false -%}

    {%- for block in section.blocks -%}

      {%- if block.settings.dvb_fp_collection != blank -%}

        {%- for product in block.settings.dvb_fp_collection.products limit: block.settings.dvb_fp_products_count -%}

          {%- assign dvb_fp_has_products = true -%}
          {%- break -%}

        {%- endfor -%}

      {%- endif -%}

      {%- if dvb_fp_has_products -%}
        {%- break -%}
      {%- endif -%}

    {%- endfor -%}


    {%- comment -%}
      ==================================================================================================
      PRODUCTS
      Section is completely hidden if there are no products.
      ==================================================================================================
    {%- endcomment -%}

    {%- if dvb_fp_has_products -%}

      <div class="dvb-fp__grid">


        {%- for block in section.blocks -%}

          {%- assign dvb_fp_collection = block.settings.dvb_fp_collection -%}


          {%- if dvb_fp_collection != blank -%}


            {%- for product in dvb_fp_collection.products limit: block.settings.dvb_fp_products_count -%}


              {%- comment -%}
                ========================================================================================
                PRODUCT CATEGORY
                Get the first actual product collection.
                "All Collections" is excluded.
                ========================================================================================
              {%- endcomment -%}

              {%- assign dvb_fp_product_category = blank -%}

              {%- for product_collection in product.collections -%}

                {%- assign dvb_fp_collection_name = product_collection.title | strip -%}
                {%- assign dvb_fp_collection_name_lower = dvb_fp_collection_name | downcase -%}

                {%- unless dvb_fp_collection_name_lower == 'all collections' -%}

                  {%- if dvb_fp_product_category == blank -%}
                    {%- assign dvb_fp_product_category = dvb_fp_collection_name -%}
                  {%- endif -%}

                {%- endunless -%}

              {%- endfor -%}


              {%- comment -%}
                ========================================================================================
                PRODUCT HIGHLIGHTS
                ========================================================================================
              {%- endcomment -%}

              {%- assign dvb_fp_product_highlights = product.metafields.custom.product_highlights.value -%}


              {%- comment -%}
                ========================================================================================
                PRODUCT RATING
                Exact metafield:

                Namespace: custom
                Key: product_rating
                Type: Rating

                First get the rating number.
                ========================================================================================
              {%- endcomment -%}

              {%- assign dvb_fp_rating_count = product.metafields.custom.product_rating.value.rating | plus: 0 -%}


              {%- comment -%}
                ========================================================================================
                PRODUCT CARD
                ========================================================================================
              {%- endcomment -%}

              <article
                class="dvb-fp__card"
                {{ block.shopify_attributes }}
              >


                {%- comment -%}
                  --------------------------------------------------------------------------------------
                  IMAGE
                  --------------------------------------------------------------------------------------
                {%- endcomment -%}

                {%- if product.featured_media != blank -%}

                  <a
                    href="{{ product.url }}"
                    class="dvb-fp__image-link"
                    aria-label="{{ product.title | escape }}"
                  >

                    <div class="dvb-fp__image-wrapper">

                      {{
                        product.featured_media
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '200,300,400,500,600,800,1000,1200',
                          sizes: '(max-width: 699px) 50vw, 25vw',
                          class: 'dvb-fp__image',
                          alt: product.featured_media.alt | default: product.title
                      }}

                    </div>

                  </a>

                {%- endif -%}


                <div class="dvb-fp__info">


                  {%- comment -%}
                    ------------------------------------------------------------------------------------
                    CATEGORY
                    ------------------------------------------------------------------------------------
                  {%- endcomment -%}

                  {%- if dvb_fp_product_category != blank -%}

                    <div class="dvb-fp__category">
                      {{ dvb_fp_product_category }}
                    </div>

                  {%- endif -%}


                  {%- comment -%}
                    ------------------------------------------------------------------------------------
                    PRODUCT TITLE
                    ------------------------------------------------------------------------------------
                  {%- endcomment -%}

                  <a
                    href="{{ product.url }}"
                    class="dvb-fp__title"
                  >
                    {{ product.title }}
                  </a>


                  {%- comment -%}
                    ------------------------------------------------------------------------------------
                    PRODUCT HIGHLIGHTS
                    ------------------------------------------------------------------------------------
                  {%- endcomment -%}

                  {%- if dvb_fp_product_highlights != blank -%}

                    <div class="dvb-fp__highlights">
                      {{ dvb_fp_product_highlights }}
                    </div>

                  {%- endif -%}


                  {%- comment -%}
                    ------------------------------------------------------------------------------------
                    PRODUCT RATING
                    ------------------------------------------------------------------------------------

                    Examples:

                    5   = ★★★★★
                    4.5 = ★★★★½
                    4   = ★★★★☆
                    3.5 = ★★★½☆
                    3   = ★★★☆☆
                    ------------------------------------------------------------------------------------
                  {%- endcomment -%}

                  {%- if dvb_fp_rating_count > 0 -%}

                    <div class="dvb-fp__rating">

                      <div
                        class="dvb-fp__stars"
                        aria-label="{{ dvb_fp_rating_count }} out of 5 stars"
                      >

                        {%- for dvb_fp_star in (1..5) -%}

                          {%- assign dvb_fp_previous_star = dvb_fp_star | minus: 1 -%}


                          {%- if dvb_fp_rating_count >= dvb_fp_star -%}

                            <span class="dvb-fp__star dvb-fp__star--full">
                              ★
                            </span>


                          {%- elsif dvb_fp_rating_count > dvb_fp_previous_star -%}

                            <span class="dvb-fp__star dvb-fp__star--half">
                              ★
                            </span>


                          {%- else -%}

                            <span class="dvb-fp__star dvb-fp__star--empty">
                              ★
                            </span>

                          {%- endif -%}

                        {%- endfor -%}

                      </div>


                      <span class="dvb-fp__rating-number">
                        {{ dvb_fp_rating_count }}
                      </span>

                    </div>

                  {%- endif -%}


                  {%- comment -%}
                    ------------------------------------------------------------------------------------
                    PRICE
                    ------------------------------------------------------------------------------------
                  {%- endcomment -%}

                  <div class="dvb-fp__price">

                    {%- render 'price-list', product: product -%}

                  </div>


                </div>

              </article>

            {%- endfor -%}

          {%- endif -%}

        {%- endfor -%}

      </div>


      {%- comment -%}
        ==================================================================================================
        CTA BUTTON
        ==================================================================================================
      {%- endcomment -%}

      {%- if section.settings.dvb_fp_show_cta -%}

        {%- assign dvb_fp_cta_link = section.settings.dvb_fp_cta_link -%}

        {%- if dvb_fp_cta_link == blank -%}

          {%- assign dvb_fp_first_collection = section.blocks.first.settings.dvb_fp_collection -%}

          {%- if dvb_fp_first_collection != blank -%}
            {%- assign dvb_fp_cta_link = dvb_fp_first_collection.url -%}
          {%- endif -%}

        {%- endif -%}


        {%- if section.settings.dvb_fp_cta_text != blank and dvb_fp_cta_link != blank -%}

          <div class="dvb-fp__cta">

            <a
              href="{{ dvb_fp_cta_link }}"
              class="button"
            >
              {{ section.settings.dvb_fp_cta_text }}
            </a>

          </div>

        {%- endif -%}

      {%- endif -%}


    {%- endif -%}

  </div>

</div>


{% schema %}
{
  "name": "DVB Featured Products",
  "tag": "section",
  "class": "shopify-section--dvb-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "dvb_fp_custom_class",
      "label": "Custom class",
      "info": "Optional custom class for this section."
    },
    {
      "type": "color_scheme",
      "id": "dvb_fp_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "dvb_fp_subheading",
      "label": "Subheading",
      "default": "Udvalgte"
    },
    {
      "type": "text",
      "id": "dvb_fp_heading",
      "label": "Heading",
      "default": "FEATURED PRODUCTS"
    },
    {
      "type": "select",
      "id": "dvb_fp_products_per_row_mobile",
      "label": "Products per row on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "dvb_fp_products_per_row_desktop",
      "label": "Products per row on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "dvb_fp_horizontal_gap",
      "label": "Horizontal gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "dvb_fp_vertical_gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "CTA button"
    },
    {
      "type": "checkbox",
      "id": "dvb_fp_show_cta",
      "label": "Show CTA button",
      "default": true
    },
    {
      "type": "text",
      "id": "dvb_fp_cta_text",
      "label": "Button text",
      "default": "SE ALLE PRODUKTER"
    },
    {
      "type": "url",
      "id": "dvb_fp_cta_link",
      "label": "Button link",
      "info": "If empty, the first selected collection link will be used."
    }
  ],
  "blocks": [
    {
      "type": "dvb_collection",
      "name": "Product collection",
      "settings": [
        {
          "type": "collection",
          "id": "dvb_fp_collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "dvb_fp_products_count",
          "label": "Products to show",
          "min": 1,
          "max": 50,
          "step": 1,
          "default": 8
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DVB Featured Products",
      "blocks": [
        {
          "type": "dvb_collection"
        }
      ]
    }
  ]
}
{% endschema %}