{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400&display=swap');

  .custom-announcement-bar {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    width: 100%;
    box-sizing: border-box;
    padding-top: {{ section.settings.padding_vertical }}px;
    padding-bottom: {{ section.settings.padding_vertical }}px;
    padding-left: 16px;
    padding-right: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    position: relative;
  }

  .custom-announcement-bar__viewport {
    width: 100%;
    max-width: 1400px;
    overflow: hidden;
    position: relative;
  }

  .custom-announcement-bar__slider {
    width: 100%;
    position: relative;
    min-height: 18px;
  }

  .custom-announcement-bar__item {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 1.76px;
    text-transform: uppercase;
    line-height: 1.3;
    text-align: center;
    white-space: nowrap;

    position: absolute;
    top: 50%;
    left: 50%;

    width: 100%;
    box-sizing: border-box;
    padding: 0 10px;

    opacity: 0;
    visibility: hidden;

    transform: translate(-50%, -50%);

    pointer-events: none;

    transition:
      transform {{ section.settings.animation_speed }}ms ease,
      opacity {{ section.settings.animation_speed }}ms ease,
      visibility {{ section.settings.animation_speed }}ms ease;
  }

  .custom-announcement-bar__item.is-active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%);
  }

  /* =========================
     TABLET
     ========================= */

  @media screen and (max-width: 989px) {

    .custom-announcement-bar {
      padding-left: 14px;
      padding-right: 14px;
    }

    .custom-announcement-bar__item {
      font-size: 10px;
      letter-spacing: 1.5px;
    }

  }

  /* =========================
     MOBILE
     ========================= */

  @media screen and (max-width: 749px) {

    .custom-announcement-bar {
      padding-left: 12px;
      padding-right: 12px;
      padding-top: 10px;
      padding-bottom: 10px;
    }

    .custom-announcement-bar__item {
      font-size: 9px;
      letter-spacing: 1.2px;
      line-height: 1.4;
      white-space: normal;
    }

  }

  /* =========================
     SMALL MOBILE
     ========================= */

  @media screen and (max-width: 480px) {

    .custom-announcement-bar {
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 9px;
      padding-bottom: 9px;
    }

    .custom-announcement-bar__item {
      font-size: 8px;
      letter-spacing: 1px;
    }

  }
{%- endstyle -%}


<div
  id="CustomAnnouncementBar-{{ section.id }}"
  class="custom-announcement-bar"
  data-change-time="{{ section.settings.change_time }}"
  data-animation-speed="{{ section.settings.animation_speed }}"
  data-direction="{{ section.settings.slide_direction }}"
>

  <div class="custom-announcement-bar__viewport">

    <div class="custom-announcement-bar__slider">

      {% for block in section.blocks %}

        <div
          class="custom-announcement-bar__item{% if forloop.first %} is-active{% endif %}"
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.text }}
        </div>

      {% endfor %}

    </div>

  </div>

</div>


<script>
(function() {

  function initAnnouncementBar() {

    const bar = document.getElementById(
      'CustomAnnouncementBar-{{ section.id }}'
    );

    if (!bar) return;

    const slider = bar.querySelector(
      '.custom-announcement-bar__slider'
    );

    const items = Array.from(
      bar.querySelectorAll(
        '.custom-announcement-bar__item'
      )
    );

    if (!slider || items.length <= 1) return;


    /* =========================================
       SETTINGS
       ========================================= */

    const changeTime =
      parseInt(
        bar.dataset.changeTime,
        10
      ) || 5;

    const animationSpeed =
      parseInt(
        bar.dataset.animationSpeed,
        10
      ) || 600;

    const direction =
      bar.dataset.direction || 'left';


    /* =========================================
       CLEAN PREVIOUS INITIALIZATION
       ========================================= */

    if (bar._announcementTimer) {
      clearInterval(
        bar._announcementTimer
      );
    }


    /* =========================================
       SET SLIDER HEIGHT
       ========================================= */

    function setSliderHeight() {

      let maxHeight = 0;

      items.forEach(function(item) {

        const height = item.scrollHeight;

        if (height > maxHeight) {
          maxHeight = height;
        }

      });

      slider.style.height =
        Math.max(maxHeight, 18) + 'px';

    }


    /* =========================================
       INITIAL STATE
       ========================================= */

    items.forEach(function(item, index) {

      item.style.transition = 'none';

      item.classList.remove(
        'is-active'
      );

      item.style.opacity = '0';
      item.style.visibility = 'hidden';
      item.style.transform =
        'translate(-50%, -50%)';

    });


    let currentIndex = 0;

    const firstItem = items[0];

    firstItem.style.transition = 'none';

    firstItem.style.opacity = '1';

    firstItem.style.visibility = 'visible';

    firstItem.style.transform =
      'translate(-50%, -50%)';

    firstItem.classList.add(
      'is-active'
    );


    /*
     * Re-enable CSS transition
     */

    requestAnimationFrame(function() {

      items.forEach(function(item) {

        item.style.transition = '';

      });

    });


    setSliderHeight();


    /* =========================================
       CHANGE SLIDE
       ========================================= */

    function changeSlide() {

      const currentItem =
        items[currentIndex];


      let nextIndex;


      if (direction === 'right') {

        nextIndex =
          currentIndex - 1;

        if (nextIndex < 0) {
          nextIndex =
            items.length - 1;
        }

      } else {

        nextIndex =
          currentIndex + 1;

        if (nextIndex >= items.length) {
          nextIndex = 0;
        }

      }


      const nextItem =
        items[nextIndex];


      /*
       * Disable transition temporarily
       */

      nextItem.style.transition =
        'none';


      /*
       * Put next item outside viewport
       */

      if (direction === 'left') {

        nextItem.style.transform =
          'translate(50%, -50%)';

      } else {

        nextItem.style.transform =
          'translate(-150%, -50%)';

      }


      nextItem.style.opacity = '0';

      nextItem.style.visibility =
        'visible';


      nextItem.classList.add(
        'is-active'
      );


      /*
       * Force browser reflow
       */

      void nextItem.offsetWidth;


      /*
       * Enable animation
       */

      nextItem.style.transition =
        'transform ' +
        animationSpeed +
        'ms ease, opacity ' +
        animationSpeed +
        'ms ease';


      currentItem.style.transition =
        'transform ' +
        animationSpeed +
        'ms ease, opacity ' +
        animationSpeed +
        'ms ease';


      /*
       * Animate current item out
       */

      if (direction === 'left') {

        currentItem.style.transform =
          'translate(-150%, -50%)';

      } else {

        currentItem.style.transform =
          'translate(50%, -50%)';

      }

      currentItem.style.opacity = '0';


      /*
       * Animate next item in
       */

      nextItem.style.transform =
        'translate(-50%, -50%)';

      nextItem.style.opacity = '1';


      /*
       * Update current index
       */

      currentIndex =
        nextIndex;


      /*
       * Clean old item after animation
       */

      setTimeout(function() {

        currentItem.classList.remove(
          'is-active'
        );

        currentItem.style.visibility =
          'hidden';

        currentItem.style.opacity =
          '0';

        currentItem.style.transform =
          'translate(-50%, -50%)';

        currentItem.style.transition =
          '';

      }, animationSpeed + 50);

    }


    /* =========================================
       START AUTOMATIC CAROUSEL
       ========================================= */

    bar._announcementTimer =
      setInterval(
        changeSlide,
        changeTime * 1000
      );


    /* =========================================
       RESIZE
       ========================================= */

    let resizeTimer;

    window.addEventListener(
      'resize',
      function() {

        clearTimeout(
          resizeTimer
        );

        resizeTimer =
          setTimeout(
            setSliderHeight,
            150
          );

      }
    );

  }


  /*
   * Start
   */

  initAnnouncementBar();


  /*
   * Shopify Theme Editor
   */

  document.addEventListener(
    'shopify:section:load',
    function(event) {

      if (
        event.detail.sectionId ===
        '{{ section.id }}'
      ) {

        initAnnouncementBar();

      }

    }
  );


})();
</script>


{% schema %}
{
  "name": "Custom Announcement Bar",

  "settings": [

    {
      "type": "select",
      "id": "slide_direction",
      "label": "Slide Direction",
      "options": [
        {
          "value": "left",
          "label": "Move Left"
        },
        {
          "value": "right",
          "label": "Move Right"
        }
      ],
      "default": "left"
    },

    {
      "type": "range",
      "id": "change_time",
      "min": 1,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "label": "Change Announcement After",
      "info": "How many seconds each announcement stays visible before changing.",
      "default": 5
    },

    {
      "type": "range",
      "id": "animation_speed",
      "min": 200,
      "max": 1500,
      "step": 100,
      "unit": "ms",
      "label": "Slide Animation Speed",
      "info": "Controls how quickly the announcement slides.",
      "default": 600
    },

    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top & Bottom Padding",
      "default": 12
    },

    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }

  ],

  "blocks": [

    {
      "type": "announcement",
      "name": "Announcement",

      "settings": [

        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "Dansk kundeservice"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "Custom Announcement Bar",

      "blocks": [

        {
          "type": "announcement",
          "settings": {
            "text": "Dansk kundeservice"
          }
        },

        {
          "type": "announcement",
          "settings": {
            "text": "14 dages fortrydelsesret"
          }
        },

        {
          "type": "announcement",
          "settings": {
            "text": "Fri fragt over 499 kr."
          }
        }

      ]

    }

  ]
}
{% endschema %}