{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400&display=swap');

  .custom-announcement-bar {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    width: 100%;
    box-sizing: border-box;
    padding-top: {{ section.settings.padding_vertical }}px;
    padding-bottom: {{ section.settings.padding_vertical }}px;
    padding-left: 16px;
    padding-right: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    position: relative;
  }

  .custom-announcement-bar__viewport {
    width: 100%;
    max-width: 1400px;
    overflow: hidden;
    position: relative;
  }

  .custom-announcement-bar__slider {
    width: 100%;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 18px;
  }

  .custom-announcement-bar__item {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 1.76px;
    text-transform: uppercase;
    line-height: 1.3;
    text-align: center;
    white-space: nowrap;
    margin: 0;
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    visibility: hidden;
    transition:
      transform 0.6s ease,
      opacity 0.6s ease;
    width: 100%;
    box-sizing: border-box;
    padding-left: 10px;
    padding-right: 10px;
  }

  .custom-announcement-bar__item.is-active {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%);
  }

  /* LEFT DIRECTION */
  .custom-announcement-bar__item.is-enter-left {
    transform: translate(calc(-50% + 100%), -50%);
  }

  .custom-announcement-bar__item.is-exit-left {
    transform: translate(calc(-50% - 100%), -50%);
  }

  /* RIGHT DIRECTION */
  .custom-announcement-bar__item.is-enter-right {
    transform: translate(calc(-50% - 100%), -50%);
  }

  .custom-announcement-bar__item.is-exit-right {
    transform: translate(calc(-50% + 100%), -50%);
  }

  /* =========================
     TABLET
     ========================= */

  @media screen and (max-width: 989px) {
    .custom-announcement-bar {
      padding-left: 14px;
      padding-right: 14px;
    }

    .custom-announcement-bar__item {
      font-size: 10px;
      letter-spacing: 1.5px;
    }
  }

  /* =========================
     MOBILE
     ========================= */

  @media screen and (max-width: 749px) {
    .custom-announcement-bar {
      padding-left: 12px;
      padding-right: 12px;
      padding-top: 10px;
      padding-bottom: 10px;
    }

    .custom-announcement-bar__item {
      font-size: 9px;
      letter-spacing: 1.2px;
      line-height: 1.4;
      white-space: normal;
    }
  }

  /* =========================
     SMALL MOBILE
     ========================= */

  @media screen and (max-width: 480px) {
    .custom-announcement-bar {
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 9px;
      padding-bottom: 9px;
    }

    .custom-announcement-bar__item {
      font-size: 8px;
      letter-spacing: 1px;
    }
  }
{%- endstyle -%}


<div
  class="custom-announcement-bar"
  id="CustomAnnouncementBar-{{ section.id }}"
  data-speed="{{ section.settings.slide_speed }}"
  data-direction="{{ section.settings.slide_direction }}"
>

  <div class="custom-announcement-bar__viewport">

    <div class="custom-announcement-bar__slider">

      {% for block in section.blocks %}

        <div
          class="custom-announcement-bar__item{% if forloop.first %} is-active{% endif %}"
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.text }}
        </div>

      {% endfor %}

    </div>

  </div>

</div>


<script>
  (function () {

    function initAnnouncementBar(sectionId) {

      const bar = document.getElementById('CustomAnnouncementBar-' + sectionId);

      if (!bar) return;

      const items = Array.from(
        bar.querySelectorAll('.custom-announcement-bar__item')
      );

      if (items.length <= 1) return;

      const slider = bar.querySelector('.custom-announcement-bar__slider');

      const speed = parseInt(bar.dataset.speed, 10) || 4;
      const direction = bar.dataset.direction || 'left';

      let currentIndex = 0;
      let timer = null;
      let isAnimating = false;

      /*
       * Set slider height based on the tallest item.
       * This keeps the announcement bar stable on mobile.
       */
      function setSliderHeight() {

        let maxHeight = 0;

        items.forEach(function (item) {

          const oldVisibility = item.style.visibility;
          const oldPosition = item.style.position;
          const oldOpacity = item.style.opacity;

          item.style.visibility = 'visible';
          item.style.position = 'absolute';
          item.style.opacity = '1';

          maxHeight = Math.max(
            maxHeight,
            item.offsetHeight
          );

          item.style.visibility = oldVisibility;
          item.style.position = oldPosition;
          item.style.opacity = oldOpacity;

        });

        slider.style.height = maxHeight + 'px';
      }


      function clearClasses(item) {

        item.classList.remove(
          'is-active',
          'is-enter-left',
          'is-exit-left',
          'is-enter-right',
          'is-exit-right'
        );

      }


      function showNext() {

        if (isAnimating) return;

        isAnimating = true;

        const currentItem = items[currentIndex];

        let nextIndex;

        if (direction === 'right') {

          nextIndex =
            currentIndex - 1;

          if (nextIndex < 0) {
            nextIndex = items.length - 1;
          }

        } else {

          nextIndex =
            currentIndex + 1;

          if (nextIndex >= items.length) {
            nextIndex = 0;
          }

        }

        const nextItem = items[nextIndex];

        /*
         * Reset classes
         */

        items.forEach(function (item, index) {

          if (
            index !== currentIndex &&
            index !== nextIndex
          ) {
            clearClasses(item);
          }

        });


        /*
         * Prepare the next slide
         */

        clearClasses(nextItem);

        if (direction === 'left') {

          nextItem.classList.add(
            'is-enter-left'
          );

        } else {

          nextItem.classList.add(
            'is-enter-right'
          );

        }


        /*
         * Force browser reflow
         * so the animation starts correctly.
         */

        void nextItem.offsetWidth;


        /*
         * Move current item out
         */

        if (direction === 'left') {

          currentItem.classList.remove(
            'is-active'
          );

          currentItem.classList.add(
            'is-exit-left'
          );

        } else {

          currentItem.classList.remove(
            'is-active'
          );

          currentItem.classList.add(
            'is-exit-right'
          );

        }


        /*
         * Move next item into view
         */

        nextItem.classList.add(
          'is-active'
        );

        nextItem.classList.remove(
          'is-enter-left',
          'is-enter-right'
        );


        currentIndex = nextIndex;


        /*
         * Wait for CSS transition
         */

        setTimeout(function () {

          clearClasses(currentItem);

          currentItem.style.visibility = 'hidden';
          currentItem.style.opacity = '0';

          clearClasses(nextItem);

          nextItem.classList.add(
            'is-active'
          );

          isAnimating = false;

        }, 650);

      }


      function startAutoplay() {

        stopAutoplay();

        timer = setInterval(
          showNext,
          speed * 1000
        );

      }


      function stopAutoplay() {

        if (timer) {

          clearInterval(timer);

          timer = null;

        }

      }


      /*
       * Initialize items
       */

      items.forEach(function (item, index) {

        clearClasses(item);

        if (index === 0) {

          item.classList.add(
            'is-active'
          );

          item.style.visibility = 'visible';
          item.style.opacity = '1';

        } else {

          item.style.visibility = 'hidden';
          item.style.opacity = '0';

        }

      });


      setSliderHeight();

      startAutoplay();


      /*
       * Recalculate height on resize
       */

      let resizeTimer;

      window.addEventListener(
        'resize',
        function () {

          clearTimeout(resizeTimer);

          resizeTimer = setTimeout(
            setSliderHeight,
            150
          );

        }
      );


      /*
       * Pause while browser tab is hidden
       */

      document.addEventListener(
        'visibilitychange',
        function () {

          if (document.hidden) {

            stopAutoplay();

          } else {

            startAutoplay();

          }

        }
      );

    }


    /*
     * Shopify theme editor
     */

    initAnnouncementBar(
      '{{ section.id }}'
    );


    document.addEventListener(
      'shopify:section:load',
      function (event) {

        if (
          event.detail.sectionId ===
          '{{ section.id }}'
        ) {

          initAnnouncementBar(
            '{{ section.id }}'
          );

        }

      }
    );

  })();
</script>


{% schema %}
{
  "name": "Custom Announcement Bar",

  "settings": [

    {
      "type": "select",
      "id": "slide_direction",
      "label": "Slide Direction",
      "options": [
        {
          "value": "left",
          "label": "Move Left"
        },
        {
          "value": "right",
          "label": "Move Right"
        }
      ],
      "default": "left"
    },

    {
      "type": "range",
      "id": "slide_speed",
      "min": 1,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "label": "Time Between Announcements",
      "default": 4
    },

    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top & Bottom Padding",
      "default": 12
    },

    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },

    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }

  ],

  "blocks": [

    {
      "type": "announcement",
      "name": "Announcement",

      "settings": [

        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "Dansk kundeservice"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "Custom Announcement Bar",

      "blocks": [

        {
          "type": "announcement",
          "settings": {
            "text": "Dansk kundeservice"
          }
        },

        {
          "type": "announcement",
          "settings": {
            "text": "14 dages fortrydelsesret"
          }
        },

        {
          "type": "announcement",
          "settings": {
            "text": "Fri fragt over 499 kr."
          }
        }

      ]

    }

  ]

}
{% endschema %}