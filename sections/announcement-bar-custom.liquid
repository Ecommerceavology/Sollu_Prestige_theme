{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400&display=swap');

  .custom-announcement-bar {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    width: 100%;
    box-sizing: border-box;
    padding-top: {{ section.settings.padding_vertical }}px;
    padding-bottom: {{ section.settings.padding_vertical }}px;
    padding-left: 16px;
    padding-right: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .custom-announcement-bar__content {
    width: 100%;
    max-width: 1400px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.item_gap }}px;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .custom-announcement-bar__item {
    font-family: 'Jost', sans-serif;
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 1.76px;
    text-transform: uppercase;
    line-height: 1.3;
    margin: 0;
    text-align: center;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .custom-announcement-bar__dot {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    line-height: 1;
    flex: 0 0 auto;
  }

  /* =========================
     TABLET
     ========================= */
  @media screen and (max-width: 989px) {
    .custom-announcement-bar {
      padding-left: 14px;
      padding-right: 14px;
    }

    .custom-announcement-bar__content {
      gap: 20px;
    }

    .custom-announcement-bar__item {
      font-size: 10px;
      letter-spacing: 1.5px;
    }

    .custom-announcement-bar__dot {
      font-size: 10px;
    }
  }

  /* =========================
     MOBILE
     ========================= */
  @media screen and (max-width: 749px) {
    .custom-announcement-bar {
      padding-left: 12px;
      padding-right: 12px;
      padding-top: 10px;
      padding-bottom: 10px;
    }

    .custom-announcement-bar__content {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      column-gap: 10px;
      row-gap: 5px;
      width: 100%;
    }

    .custom-announcement-bar__item {
      font-size: 9px;
      letter-spacing: 1.2px;
      line-height: 1.4;
      white-space: normal;
    }

    .custom-announcement-bar__dot {
      font-size: 9px;
      line-height: 1;
    }
  }

  /* =========================
     SMALL MOBILE
     ========================= */
  @media screen and (max-width: 480px) {
    .custom-announcement-bar {
      padding-left: 10px;
      padding-right: 10px;
      padding-top: 9px;
      padding-bottom: 9px;
    }

    .custom-announcement-bar__content {
      column-gap: 7px;
      row-gap: 4px;
    }

    .custom-announcement-bar__item {
      font-size: 8px;
      letter-spacing: 1px;
    }

    .custom-announcement-bar__dot {
      font-size: 8px;
    }
  }
{%- endstyle -%}

<div class="custom-announcement-bar">
  <div class="custom-announcement-bar__content">

    {% for block in section.blocks %}

      <span
        class="custom-announcement-bar__item"
        {{ block.shopify_attributes }}
      >
        {{ block.settings.text }}
      </span>

      {% unless forloop.last %}
        <span class="custom-announcement-bar__dot">·</span>
      {% endunless %}

    {% endfor %}

  </div>
</div>

{% schema %}
{
  "name": "Custom Announcement Bar",
  "settings": [
    {
      "type": "range",
      "id": "item_gap",
      "min": 0,
      "max": 150,
      "step": 2,
      "unit": "px",
      "label": "Space between items (Horizontal)",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top & Bottom Padding (Vertical)",
      "default": 12
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    }
  ],

  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "Dansk kundeservice"
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Custom Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Dansk kundeservice"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "14 dages fortrydelsesret"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Fri fragt over 499 kr."
          }
        }
      ]
    }
  ]
}
{% endschema %}

