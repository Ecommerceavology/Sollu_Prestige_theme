{%- if cart_drawer -%}

  {%- assign free_shipping_threshold = 49900 -%}
  {%- assign cart_total = cart.total_price -%}

  {%- if cart_total >= free_shipping_threshold -%}
    {%- assign shipping_progress = 100 -%}
    {%- assign remaining_amount = 0 -%}
  {%- else -%}
    {%- assign shipping_progress = cart_total | times: 100.0 | divided_by: free_shipping_threshold -%}
    {%- assign remaining_amount = free_shipping_threshold | minus: cart_total -%}
  {%- endif -%}

  <div
    class="sollu-free-shipping"
    data-free-shipping-threshold="49900"
  >

    <div class="sollu-free-shipping__message">
      {%- if cart_total >= free_shipping_threshold -%}

        Tillykke! Du har opnået fri fragt 🎉

      {%- else -%}

        Du er kun
        <span class="sollu-free-shipping__remaining">
          {{ remaining_amount | money }}
        </span>
        fra fri fragt!

      {%- endif -%}
    </div>

    <div class="sollu-free-shipping__bar">

      <div
        class="sollu-free-shipping__fill"
        style="width: {{ shipping_progress }}%;"
      ></div>

    </div>

    <div class="sollu-free-shipping__labels">
      <span>0 kr.</span>
      <span>499 kr.</span>
    </div>

  </div>


  <style>
    /*
     * FREE SHIPPING BAR
     * CART DRAWER ONLY
     */

    #cart-drawer .sollu-free-shipping {
      display: block !important;
      width: 100%;
      box-sizing: border-box;
      padding: 14px 16px;
      margin: 0;
      background: #f8f8f8;
      border-radius: 0;
    }

    #cart-drawer .sollu-free-shipping__message {
      display: block;
      width: 100%;
      margin: 0 0 10px;
      padding: 0;
      color: #222;
      font-size: 14px;
      line-height: 1.4;
      font-weight: 500;
      text-align: center;
    }

    #cart-drawer .sollu-free-shipping__remaining {
      font-weight: 600;
    }

    #cart-drawer .sollu-free-shipping__bar {
      display: block;
      position: relative;
      width: 100%;
      height: 7px;
      overflow: hidden;
      background: #e2e2e2;
      border-radius: 999px;
    }

    #cart-drawer .sollu-free-shipping__fill {
      display: block;
      height: 100%;
      min-width: 0;
      max-width: 100%;
      background: #222;
      border-radius: 999px;
      transition: width 0.5s ease;
    }

    #cart-drawer .sollu-free-shipping__labels {
      display: flex;
      justify-content: space-between;
      width: 100%;
      margin-top: 6px;
      padding: 0;
      color: #777;
      font-size: 11px;
      line-height: 1;
    }

    @media screen and (max-width: 749px) {

      #cart-drawer .sollu-free-shipping {
        padding: 12px 14px;
      }

      #cart-drawer .sollu-free-shipping__message {
        font-size: 13px;
      }

      #cart-drawer .sollu-free-shipping__bar {
        height: 6px;
      }

    }
  </style>


  <script>
    (function () {

      'use strict';

      var THRESHOLD = 49900;


      function formatDKK(amount) {

        return (
          (Number(amount) / 100).toLocaleString('da-DK', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }) + ' kr.'
        );

      }


      function updateShippingBar(cart) {

        var drawer = document.querySelector(
          '#cart-drawer'
        );

        if (!drawer) {
          return;
        }


        var container = drawer.querySelector(
          '.sollu-free-shipping'
        );

        if (!container) {
          return;
        }


        var message = container.querySelector(
          '.sollu-free-shipping__message'
        );

        var fill = container.querySelector(
          '.sollu-free-shipping__fill'
        );


        if (!message || !fill) {
          return;
        }


        var total = Number(
          cart.total_price || 0
        );


        var percentage =
          (total / THRESHOLD) * 100;


        percentage = Math.max(
          0,
          Math.min(
            percentage,
            100
          )
        );


        fill.style.width =
          percentage + '%';


        if (total >= THRESHOLD) {

          message.innerHTML =
            'Tillykke! Du har opnået fri fragt 🎉';

        } else {

          var remaining =
            THRESHOLD - total;


          message.innerHTML =
            'Du er kun ' +
            '<span class="sollu-free-shipping__remaining">' +
            formatDKK(remaining) +
            '</span>' +
            ' fra fri fragt!';

        }

      }


      function updateFromCart() {

        fetch(
          '/cart.js',
          {
            credentials: 'same-origin',
            headers: {
              'Accept': 'application/json'
            }
          }
        )
        .then(function (response) {

          return response.json();

        })
        .then(function (cart) {

          updateShippingBar(cart);

        })
        .catch(function (error) {

          console.error(
            'Free shipping error:',
            error
          );

        });

      }


      /*
       * Initial update
       */

      if (
        document.readyState === 'loading'
      ) {

        document.addEventListener(
          'DOMContentLoaded',
          updateFromCart
        );

      } else {

        updateFromCart();

      }


      /*
       * Shopify / Prestige events
       */

      document.addEventListener(
        'cart:updated',
        updateFromCart
      );


      document.addEventListener(
        'cart:change',
        updateFromCart
      );


      document.addEventListener(
        'cart:refresh',
        updateFromCart
      );


      /*
       * Detect Shopify AJAX cart requests
       */

      var originalFetch =
        window.fetch;


      window.fetch = function () {

        var args = arguments;


        return originalFetch
          .apply(this, args)
          .then(function (response) {


            var request =
              args[0];


            var url = '';


            if (
              typeof request === 'string'
            ) {

              url = request;

            } else if (
              request &&
              request.url
            ) {

              url = request.url;

            }


            if (

              url.indexOf('/cart/add') !== -1 ||

              url.indexOf('/cart/change') !== -1 ||

              url.indexOf('/cart/update') !== -1 ||

              url.indexOf('/cart/clear') !== -1

            ) {

              setTimeout(
                updateFromCart,
                300
              );

            }


            return response;

          });

      };


    })();
  </script>

{%- endif -%}